    , "items" : [{"_about" : "https://datos.gob.es/catalogo/e00003801-tpfe-aprovisionamiento-de-materias-primas-consumidas-en-los-centros-penitenciarios-y-centros-de-insercion-social-cis", "accrualPeriodicity" : "http://publications.europa.eu/resource/authority/frequency/MONTHLY", "conformsTo" : "https://datosgobes.github.io/DCAT-AP-ES/", "description" : [{"_value" : "Conjunto de datos relativo al consumo de materias primas en los centros penitenciarios y CIS gestionados en el ámbito de TPFE. Incluye la identificación del centro, la clasificación y descripción de la materia prima, la cantidad consumida y la unidad de medida correspondiente. Su contenido permite conocer y comparar los consumos de materias primas entre centros. No se incluyen los datos de los centros de Cataluña ni del País Vasco, al tratarse de una competencia transferida a dichas comunidades autónomas.", "_lang" : "es"}
