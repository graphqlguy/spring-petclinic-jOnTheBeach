# The entry point of our API. This line is a comment, by the way:
# comments start with # and are only for people reading this file.
"The queries a client can send"
type Query {
    ownersAll: [Owner!]! @deprecated(reason: "Unbounded. Use 'owners' instead.")
    owner(id: ID!): Owner
    owners(filter: OwnerFilter, page: Int! = 0, size: Int! = 10, sort: OwnerSort): OwnerPage!
    vets: [Vet!]!
    vet(id: ID!): Vet
    "The visits from one date to another, both included, in date order"
    visits(from: Date!, to: Date!): [Visit!]!
    petTypes: [PetType!]!
    "Owners, vets and pets whose name contains the text, in upper or lower case"
    search(text: String!): [SearchResult!]!
    "Owners and vets whose first or last name contains the text, in upper or lower case"
    people(name: String!): [Person!]!
}

"Something a search can find"
union SearchResult = Owner | Pet | Vet

"A person the clinic knows: an owner or a vet"
interface Person {
    id: ID!
    firstName: String!
    lastName: String!
}

"""
An owner of one or more pets, and a client of the clinic.
Triple quotes allow a description over several lines.
"""
# We extend the Owner type as the workshop goes on
type Owner implements Person {
    id: ID!
    firstName: String!
    lastName: String!
    address: String!
    city: String!
    "Ten digits, such as 9521234567. Only staff can read it."
    telephone: String
    pets: [Pet!]!
}

"A pet of an owner, and a patient of the clinic"
type Pet {
    id: ID!
    name: String!
    birthDate: Date
    type: PetType!
    owner: Owner!
    "The visits of this pet, oldest first"
    visits: [Visit!]!
}

"A kind of pet, such as cat or dog"
type PetType {
    id: ID!
    name: String!
}

enum OwnerSortField {
    LAST_NAME
    FIRST_NAME
    CITY
}

enum SortOrder {
    ASC
    DESC
}

input OwnerFilter {
    "Owners whose last name starts with this text, in upper or lower case"
    lastName: String
    "Owners who live in this city, in upper or lower case"
    city: String
}

input OwnerSort {
    field: OwnerSortField
    order: SortOrder
}

"One page of owners. Pages count from 0."
type OwnerPage {
    content: [Owner!]!
    totalElements: Int!
    totalPages: Int!
    currentPage: Int!
    size: Int!
    isFirst: Boolean!
    isLast: Boolean!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

"A veterinarian of the clinic"
type Vet implements Person {
    id: ID!
    firstName: String!
    lastName: String!
    specialties: [Specialty!]!
    "The visits this vet has seen or will see, newest first"
    visits: [Visit!]!
}

"A visit of a pet to the clinic, past or booked"
type Visit {
    id: ID!
    date: Date!
    description: String!
    pet: Pet!
    "The vet who sees the pet. The Petclinic web pages book visits without a vet."
    vet: Vet
}

"A field a vet specializes in, such as surgery"
type Specialty {
    id: ID!
    name: String!
    "The vets who have this specialty"
    vets: [Vet!]!
}

scalar Date @specifiedBy(url: "https://tools.ietf.org/html/rfc3339")

"Changes to the clinic's data"
type Mutation {
    addVisit(input: AddVisitInput!): Visit!
    addOwner(input: AddOwnerInput!): Owner!
    updateOwner(input: UpdateOwnerInput!): Owner!
    addPet(input: AddPetInput!): Pet!
    updatePet(input: UpdatePetInput!): Pet!
    "Signs in, and returns the access token to send as 'Authorization: Bearer <token>'"
    login(username: String!, password: String!): String!
}

input AddVisitInput {
    petId: ID!
    "Leave it out to book the visit without a vet"
    vetId: ID
    "Leave it out to book the visit for tomorrow"
    date: Date
    description: String!
}

input AddOwnerInput {
    firstName: String!
    lastName: String!
    address: String!
    city: String!
    "Ten digits, such as 9521234567"
    telephone: String!
}

"The fields to change. A field left out keeps its value."
input UpdateOwnerInput {
    id: ID!
    firstName: String
    lastName: String
    address: String
    city: String
    telephone: String
}

input AddPetInput {
    ownerId: ID!
    name: String!
    birthDate: Date!
    typeId: ID!
}

"The fields to change. A field left out keeps its value."
input UpdatePetInput {
    id: ID!
    name: String
    birthDate: Date
    typeId: ID
}
