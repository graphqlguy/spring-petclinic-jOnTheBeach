scalar Date @specifiedBy(url: "https://tools.ietf.org/html/rfc3339")
directive @PositiveOrZero(message: String = "graphql.validation.PositiveOrZero.message") on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @Range(min: Int = 0, max: Int = 2147483647, message: String = "graphql.validation.Range.message") on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

# The entry point of our API. This line is a comment:
# comments start with # and are only for people reading this file.
"The queries a client can send."
type Query {
    "Every owner of the clinic, in one list, without filters."
    ownersAll: [Owner!]! @deprecated(reason: "Unbounded. Use 'owners' instead.")
    owner(id: ID!): Owner
    owners(filter: OwnerFilter, page: Int! = 0 @PositiveOrZero, size: Int! = 10 @Range(min: 1, max: 100), sort: OwnerSort): OwnerPage!
    vets: [Vet!]!
    vet(id: ID!): Vet
    petTypes: [PetType!]!
    "Owners, vets and pets whose name contains the text, in upper or lower case."
    search(text: String!): [SearchResult!]!
    "Owners and vets whose first or last name contains the text, in upper or lower case."
    people(name: String!): [Person!]!
}

"An owner, a vet or a pet that a search found."
union SearchResult = Owner | Pet | Vet

"A person the clinic knows: an owner or a vet."
interface Person {
    id: ID!
    firstName: String!
    lastName: String!
}

"""
A client of the clinic, who owns one or more pets.
Triple quotes allow a description over several lines.
"""
# We extend the Owner type as the workshop goes on
type Owner implements Person {
    id: ID!
    firstName: String!
    lastName: String!
    address: String!
    city: String!
    "The owner's telephone number as ten digits, for example 9521234567. Only staff can read it."
    telephone: String
    pets: [Pet!]!
}

"An animal that an owner has registered with the clinic."
type Pet {
    id: ID!
    name: String!
    birthDate: Date
    type: PetType!
    owner: Owner!
    "The pet's visits to the clinic, oldest first."
    visits: [Visit!]!
}

"A kind of pet the clinic treats, such as cat or dog."
type PetType {
    id: ID!
    name: String!
}

enum OwnerSortField {
    LAST_NAME
    FIRST_NAME
    CITY
}

enum SortOrder {
    ASC
    DESC
}

input OwnerFilter {
    "Keeps the owners whose last name starts with this text. It matches in upper or lower case."
    lastName: String
    "Keeps the owners who live in this city. It matches in upper or lower case."
    city: String
}

input OwnerSort {
    field: OwnerSortField
    order: SortOrder
}

"One page of owners. Pages count from 0."
type OwnerPage {
    content: [Owner!]!
    totalElements: Int!
    totalPages: Int!
    currentPage: Int!
    size: Int!
    isFirst: Boolean!
    isLast: Boolean!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

"A veterinarian who works at the clinic."
type Vet implements Person {
    id: ID!
    firstName: String!
    lastName: String!
    specialties: [Specialty!]!
    "The visits this vet has seen or will see, newest first."
    visits: [Visit!]!
}

"A pet's visit to the clinic, in the past or booked for later."
type Visit {
    id: ID!
    date: Date!
    description: String!
    pet: Pet!
    "The vet who sees the pet, or null when the visit was booked without one, as the Petclinic web pages do."
    vet: Vet
}

"An area of veterinary medicine that a vet specializes in, such as surgery."
type Specialty {
    id: ID!
    name: String!
}

"Changes to the clinic's data."
type Mutation {
    addVisit(input: AddVisitInput!): Visit!
    addOwner(input: AddOwnerInput!): Owner!
    updateOwner(input: UpdateOwnerInput!): Owner!
    addPet(input: AddPetInput!): Pet!
    updatePet(input: UpdatePetInput!): Pet!
    "Signs in, and returns the access token to send as 'Authorization: Bearer <token>'."
    login(username: String!, password: String!): String!
}

input AddVisitInput {
    petId: ID!
    "Leave it out to book the visit without a vet."
    vetId: ID
    "Leave it out to book the visit for tomorrow."
    date: Date
    description: String!
}

input AddOwnerInput {
    firstName: String!
    lastName: String!
    address: String!
    city: String!
    "The owner's telephone number as ten digits, for example 9521234567."
    telephone: String!
}

"The details to change for one owner. A field left out keeps its value."
input UpdateOwnerInput {
    id: ID!
    firstName: String
    lastName: String
    address: String
    city: String
    telephone: String
}

input AddPetInput {
    ownerId: ID!
    name: String!
    birthDate: Date!
    typeId: ID!
}

"The details to change for one pet. A field left out keeps its value."
input UpdatePetInput {
    id: ID!
    name: String
    birthDate: Date
    typeId: ID
}
