"""
The addresses of Spain from CartoCiudad: the street, the number, the postal code and the town of each entrance of a
building, with its point
"""
type IgnAddress {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The local id of the feature in its INSPIRE dataset"
    localId: String
    "The namespace of the INSPIRE id, such as ES.SCNE.CARTOCIUDAD"
    namespace: String
    "The street, in capitals, such as CALLE VENDEJA"
    thoroughfareName: String
    "The number of the address, such as 6"
    addressNumber: String
    "The letter or extension after the number, such as B"
    addressNumberExtension: String
    "The postal code, such as 29001"
    postalCode: String
    "The town or district of the address, such as Málaga"
    addressArea: String
    "The municipality, such as Málaga"
    municipality: String
    "The province, such as Málaga"
    province: String
    "The autonomous community, such as Andalucía"
    region: String
    "The day this version of the feature entered the dataset"
    validSince: String
    "Who supplied the data, such as Dirección General de Catastro"
    dataProvider: String
}

"A page of the addresses of the IGN"
type IgnAddressPage {
    "The number of addresses that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The addresses"
    features: [IgnAddress]
}

"The datasets of existing land use of the SIOSE land information system, with the area each covers"
type IgnLandUseDataset {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The local id of the feature in its INSPIRE dataset"
    localId: String
    "The namespace of the INSPIRE id, such as ES.SCNE.SIOSE"
    namespace: String
    "The version of the INSPIRE id, such as 2017"
    versionId: String
    "The name of the dataset"
    name: String
    "The day this version of the feature entered the dataset"
    validSince: String
    "The day this version of the feature left the dataset, or null while it is current"
    validUntil: String
    "The first day the data is valid for"
    validFrom: String
    "The last day the data is valid for"
    validTo: String
}

"A page of the land use datasets of the IGN"
type IgnLandUseDatasetPage {
    "The number of land use datasets that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The land use datasets"
    features: [IgnLandUseDataset]
}

"""
The areas of existing land use from SIOSE AR 2017, each with its use in the HILUCS classification, such as residential
or agricultural
"""
type IgnLandUseArea {
    "The id of the feature, for the field that reads one"
    id: ID
