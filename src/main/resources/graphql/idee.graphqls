# The fields of the API-Features service of the National Cartographic System of Spain (SCNE), run by the National
# Geographic Institute (IGN), at api-features.idee.es. It follows the OGC API Features standard and serves the INSPIRE
# themes of addresses, land use, land cover, hydrography and transport networks as collections of features. A generator
# wrote one field to search each collection and one to read a feature by its id, with their types and
# src/main/resources/idee/operations.json, from the OpenAPI document of the service, which lists the properties each
# collection can be filtered by, and from answers recorded from it. The names and descriptions are written by hand in
# English. Each field is fetched by a RestOperationFetcher, see IdeeConfiguration.

extend type Query {
    # Every collection takes a bounding box, such as -4.50,36.65,-4.35,36.75 for the city of Málaga, and filters on its
    # properties by exact value. Lines and areas, such as rivers, can have long geometries, so the searches leave the
    # geometry out unless skipGeometry is false.

    """
    The addresses of Spain from CartoCiudad: the street, the number, the postal code and the town of each entrance of a
    building, with its point. The addresses of the street of an owner take thoroughfareName, such as CALLE VENDEJA.
    """
    ignAddresses(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
        skipGeometry: Boolean = true
        "Only the addresses whose localId is this value"
        localId: String
        "Only the addresses whose namespace is this value"
        namespace: String
        "Only the addresses whose thoroughfareName is this value"
        thoroughfareName: String
        "Only the addresses whose addressNumber is this value"
        addressNumber: String
        "Only the addresses whose addressNumberExtension is this value"
        addressNumberExtension: String
        "Only the addresses whose postalCode is this value"
        postalCode: String
        "Only the addresses whose addressArea is this value"
        addressArea: String
        "Only the addresses whose municipality is this value"
        municipality: String
        "Only the addresses whose province is this value"
        province: String
        "Only the addresses whose region is this value"
        region: String
        "Only the addresses whose validSince is this value"
        validSince: String
        "Only the addresses whose dataProvider is this value"
        dataProvider: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnAddressPage

    "One of the addresses by its id, with its geometry"
    ignAddress(
        "The id of the feature, which ignAddresses gives"
        id: ID!
    ): IgnAddress

    "The datasets of existing land use of the SIOSE land information system, with the area each covers"
    ignLandUseDatasets(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
        skipGeometry: Boolean = true
        "Only the land use datasets whose localId is this value"
        localId: String
        "Only the land use datasets whose namespace is this value"
        namespace: String
        "Only the land use datasets whose versionId is this value"
        versionId: String
        "Only the land use datasets whose name is this value"
        name: String
        "Only the land use datasets whose validSince is this value"
        validSince: String
        "Only the land use datasets whose validUntil is this value"
        validUntil: String
        "Only the land use datasets whose validFrom is this value"
        validFrom: String
        "Only the land use datasets whose validTo is this value"
        validTo: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnLandUseDatasetPage

