    """
    The energy not supplied (ENS) because of incidents in the transmission grid, accumulated over the year, a measure of
    the quality of service
    """
    reeEnergyNotSupplied(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    """
    The rate at which the transmission grid was unavailable, by cause: scheduled maintenance, other scheduled work,
    corrective maintenance, unforeseen circumstances, force majeure, and the total
    """
    reeGridUnavailability(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The average interruption time (AIT) of the supply because of the transmission grid, in minutes"
    reeAverageInterruptionTime(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The length of the transmission grid, in kilometres of circuit, at 400 kV, 220 kV and 132 kV"
    reeGridLength(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The availability of the transmission grid each month, in percent"
    reeGridAvailability(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The number of power outages of the transmission grid"
    reePowerOutages(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    """
    The energy not supplied and the average interruption time, for Spain, the peninsula, the Balearic Islands and the
    Canary Islands
    """
    reeEnergyNotSuppliedAndInterruptionTime(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The total availability of the transmission grid, in percent"
    reeTotalGridAvailability(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    """
    The components of the final price of electricity, in euros per MWh: the daily and intraday markets, each adjustment
    service, the capacity payments, the total price, and the energy it applies to
    """
    reePriceComponents(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The energy programmed up and down for the security of the grid in the adjustment services"
    reeAdjustmentServicesEnergy(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The energy raised and lowered to solve technical constraints, in the daily schedule (PDBF) and in real time"
    reeConstraintEnergy(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The weighted average prices of solving technical constraints, in the daily schedule (PDBF) and in real time"
    reeConstraintPrices(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The secondary regulation band: the power reserved to go up and down, and its average price"
    reeSecondaryRegulationBand(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The energy of secondary regulation up and down, and its prices"
    reeSecondaryRegulation(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The energy of tertiary regulation up and down, and its prices"
    reeTertiaryRegulation(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The cost of the adjustment services of the grid, in euros"
    reeAdjustmentServicesCost(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The energy of the adjustment services and its variation against the year before"
    reeAdjustmentServicesVolumeVariation(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The prices of deviation management up and down, before the replacement reserve (RR) balance"
    reeDeviationManagementPricesBefore(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The prices of deviation management up and down, with the replacement reserve (RR) balance"
    reeDeviationManagementPrices(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    "The prices of deviation management after the replacement reserve (RR) balance"
    reeDeviationManagementPricesAfter(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
    ): ReeIndicator

    """
    The price of electricity in the peninsula hour by hour: the regulated price for households (PVPC) and the spot price
    of the market, in euros per MWh. Ask with timeTrunc HOUR for one day.
    """
    reeElectricityPrices(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. HOUR, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = HOUR
    ): ReeIndicator
}

"An indicator of the Spanish electricity grid"
type ReeIndicator {
    "The id of the indicator, such as bal1"
    id: String
    "The title, such as Electrical energy balance. Some titles are in Spanish."
    title: String
    "What the indicator measures, or null"
    description: String
    "When Red Eléctrica last updated the figures, written as 2026-10-20T20:46:36.000+02:00"
    lastUpdate: String
    "The series of the indicator, such as the generation of each technology"
    series: [ReeSeries]
}

"A series of values of an indicator, or a group of series"
type ReeSeries {
    "The id of the series"
    id: String
    "The name of the series as the indicator groups it, such as Renewable"
    type: String
    "The group the series belongs to, or null"
    groupId: String
    "The title, such as Wind or Exports"
    title: String
    "What the series measures, or null"
    description: String
    "The kind of series, such as distinct, total, export, import or saldo (balance)"
    kind: String
    "The magnitude of the values, such as price or time, or null for energy"
    magnitude: String
    "Whether the series adds up others"
    composite: Boolean
    "The colour of the series in the charts of Red Eléctrica, as #RRGGBB"
    color: String
    "When the series last changed, as a date and time, or a number in some series"
    lastUpdate: String
    "The values over the period, oldest first"
    values: [ReeValue]
    "The series inside a group, such as the technologies of Renewable"
    parts: [ReeSeries]
}

"One value of a series"
type ReeValue {
    """
    The start of the hour, day, month or year of the value, written as 2026-10-01T00:00:00.000+02:00, or without an
    offset, as 2026-01-01T00:00, by some indicators
    """
    datetime: String
    "The value, in MWh, MW, euros per MWh or the unit of the indicator"
    value: Float
    "The share of the value in its group, from 0 to 1"
    percentage: Float
}

"How the values of an indicator of Red Eléctrica are grouped over time"
enum ReeTimeTrunc {
    "One value for each hour"
    HOUR
    "One value for each day"
    DAY
    "One value for each month"
    MONTH
    "One value for each year"
    YEAR
}
