    reeServicesConsumptionIndex(
        "The first day of the period, such as 2026-10-01, in the time of Madrid"
        startDate: Date!
        "The last day of the period, such as 2026-10-20. It can be the same day as startDate."
        endDate: Date!
        "How the values are grouped. MONTH, the default, is one this indicator accepts."
        timeTrunc: ReeTimeTrunc! = MONTH
