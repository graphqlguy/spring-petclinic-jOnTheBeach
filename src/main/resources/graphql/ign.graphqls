    "The province, such as Málaga"
    province: String
    "The INE code of the municipality, such as 29067"
    municipalityCode: Int
    "The INE code of the province, such as 29"
    provinceCode: Int
    "The sheet of the 1:50,000 national map, such as 1053"
    mapSheet: String
    "When the point was built"
