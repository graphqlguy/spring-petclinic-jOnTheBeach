"The boundaries between administrative units, such as between two municipalities, with their level and legal status"
type IgnAdministrativeBoundary {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The id of the record in the database of the IGN"
    gid: String
    "The national code of the unit or boundary, such as 34012929067 for the municipality of Málaga"
    nationalCode: String
    "The country, ES"
    country: String
    "The units on each side of the boundary, separated by #, such as Málaga#Torremolinos"
    boundaryName: String
    "The kind of boundary, such as Límite terrestre (on land) or Litoral (the coast)"
    boundaryType: String
    "The day the boundary was set or last changed"
    boundaryDate: String
    "The address of the official documents of the boundary at the download centre of the CNIG"
    documentUrl: String
    "The level of the unit, as the address of a value in an INSPIRE code list, such as 4thOrder for a municipality"
    nationalLevel: String
    "The level of the unit in words, such as Municipio or Provincia"
    levelName: String
    "Whether the boundary is agreed"
    legalStatus: String
    "How the boundary was measured, in Spanish"
    accuracy: String
    "The day this version of the feature left the dataset, or null while it is current"
    validUntil: String
    "Why legalStatus is empty, as an INSPIRE nil reason, such as unknown"
    legalStatusNilReason: String
    "Whether legalStatus is empty on purpose"
    legalStatusMissing: Boolean
}

"A page of the administrative boundaries of the IGN"
type IgnAdministrativeBoundaryPage {
    "The number of administrative boundaries that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The administrative boundaries"
    features: [IgnAdministrativeBoundary]
}

"""
The administrative units of Spain: the country, the autonomous communities, the provinces and the municipalities, with
their national codes and NUTS codes
"""
type IgnAdministrativeUnit {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The id of the record in the database of the IGN"
    gid: String
    "The country, ES"
    country: String
    "The national code of the unit or boundary, such as 34012929067 for the municipality of Málaga"
    nationalCode: String
    "The name of the unit, such as Málaga"
    name: String
    "The NUTS 1 code of the unit, such as ES6 for the South of Spain"
    nuts1: String
    "The NUTS 2 code, such as ES61 for Andalusia"
    nuts2: String
    "The NUTS 3 code, such as ES617 for the province of Málaga"
    nuts3: String
    "The level of the unit, as the address of a value in an INSPIRE code list, such as 4thOrder for a municipality"
    nationalLevel: String
    "The level of the unit in words, such as Municipio or Provincia"
    levelName: String
}

"A page of the administrative units of the IGN"
type IgnAdministrativeUnitPage {
    "The number of administrative units that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The administrative units"
    features: [IgnAdministrativeUnit]
}

"""
The geographic names of Spain from the Nomenclátor Geográfico Básico: towns, hills, rivers, beaches and any other named
feature, with its kind and source
"""
type IgnNamedPlace {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The id of the named place in the Nomenclátor"
    identity: String
    "The name, such as Guadalmar"
    label: String
    "The kind of feature, such as Zona encharcable (land that floods) or Barrio (neighbourhood)"
    kind: String
    "The code of the kind of place in the Nomenclátor Geográfico Básico, such as 2.1.8"
    ngbeCode: String
    "The kind of name, such as identificador_geografico"
    nameType: String
    "The source of the data, as a code of the dataset"
    source: String
    "The date of the record"
    date: String
}

"A page of the named places of the IGN"
type IgnNamedPlacePage {
    "The number of named places that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The named places"
    features: [IgnNamedPlace]
}

"""
The population centres the National Statistics Institute (INE) recognizes, with their number of inhabitants and whether
each is the capital of its municipality
"""
type IgnPopulationCentre {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The id of the settlement"
    settlementId: String
    "The name of the feature, such as Aeropuerto de Málaga-Costa del Sol"
    name: String
    "The INE code of the province, such as 29"
    provinceCode: Int
    "The kind of feature, such as Zona encharcable (land that floods) or Barrio (neighbourhood)"
    kind: String
    "Whether the INE lists the settlement: 1 for yes, 0 for no"
    inIne: Int
    "The INE code of the population centre, such as 29067000201"
    ineCode: String
    "The number of inhabitants"
    inhabitants: Int
    "The id of the population entity"
    entityId: Int
    "Whether the place is a capital, as a code of six digits, such as 001100"
    capitalCode: String
    "Whether the centre is rural: 1 for yes, 0 for no"
    rural: Int
    "Whether the settlement is isolated: 1 for yes, 0 for no"
    isolated: Int
    "The latitude"
    latitude: Float
    "The length, in metres"
    lengthMetres: Float
    "The altitude, in metres"
    altitude: Float
    "The date of the record"
    date: String
}

"A page of the population centres of the IGN"
type IgnPopulationCentrePage {
    "The number of population centres that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The population centres"
    features: [IgnPopulationCentre]
}

"The settlements that the INE does not count as population centres, such as scattered houses, with their inhabitants"
type IgnOtherSettlement {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The id of the settlement"
    settlementId: String
    "The name of the feature, such as Aeropuerto de Málaga-Costa del Sol"
    name: String
    "The INE code of the province, such as 29"
    provinceCode: Int
    "The kind of feature, such as Zona encharcable (land that floods) or Barrio (neighbourhood)"
    kind: String
    "Whether the INE lists the settlement: 1 for yes, 0 for no"
    inIne: Int
    "The INE code of the population centre, such as 29067000201"
    ineCode: String
    "The number of inhabitants"
    inhabitants: String
    "The id of the population entity"
    entityId: Int
    "Whether the place is a capital, as a code of six digits, such as 001100"
    capitalCode: String
    "Whether the centre is rural: 1 for yes, 0 for no"
    rural: Int
    "Whether the settlement is isolated: 1 for yes, 0 for no"
    isolated: Int
    "The latitude"
    latitude: Float
    "The length, in metres"
    lengthMetres: Float
    "The altitude, in metres"
    altitude: Float
    "The date of the record"
    date: String
}

"A page of the other settlements of the IGN"
type IgnOtherSettlementPage {
    "The number of other settlements that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The other settlements"
    features: [IgnOtherSettlement]
}

"The inhabited places without a known name"
type IgnUnnamedSettlement {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The id of the place in the geographic information system of the IGN"
    seigId: String
    "The id of the settlement"
    settlementId: Int
    "The name of the feature, such as Aeropuerto de Málaga-Costa del Sol"
    name: String
    "The INE code of the province, such as 29"
    provinceCode: Int
    "The date of the record"
    date: String
}

"A page of the unnamed settlements of the IGN"
type IgnUnnamedSettlementPage {
    "The number of unnamed settlements that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The unnamed settlements"
    features: [IgnUnnamedSettlement]
}

"The permanent GNSS reference stations of the IGN (ERGNSS), with their positions and the networks they belong to"
type IgnGnssStation {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The code of the station, such as MALA for Málaga"
    code: String
    "The name of the feature, such as Aeropuerto de Málaga-Costa del Sol"
    name: String
    "The code of the station at the International Earth Rotation Service, such as 13443M001"
    iersCode: String
    "When the station was installed"
    installed: String
    "The municipality, such as Málaga"
    municipality: String
    "The province, such as Málaga"
    province: String
    "The place, such as Málaga, Andalucía"
    location: String
    "The length, in metres"
    lengthMetres: Float
    "The latitude"
    latitude: Float
    "The height above the ellipsoid, in metres"
    ellipsoidalHeight: Float
    "The geocentric X coordinate, in metres"
    cartesianX: Float
    "The geocentric Y coordinate, in metres"
    cartesianY: Float
    "The geocentric Z coordinate, in metres"
    cartesianZ: Float
    "The UTM easting, in metres"
    utmX: Float
    "The UTM northing, in metres"
    utmY: Float
    "The UTM zone, such as 30"
    utmZone: Float
    "The height above sea level, in metres"
    orthometricHeight: Float
    "The main network of the station, such as ERGNSS"
    mainNetwork: String
    "The other networks the station belongs to, such as EUREF"
    otherNetworks: [String]
    "The address of the PDF that describes the point"
    descriptionSheet: String
    "The address of the log of the station"
    logUrl: String
}

"A page of the GNSS reference stations of the IGN"
type IgnGnssStationPage {
    "The number of GNSS reference stations that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The GNSS reference stations"
    features: [IgnGnssStation]
}

"The benchmarks of the high precision levelling network of Spain (REDNAP), with their heights"
type IgnLevellingBenchmark {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
    "The number, such as the kilometre of the post"
    number: String
    "The name of the feature, such as Aeropuerto de Málaga-Costa del Sol"
    name: String
    "The municipality, such as Málaga"
    municipality: String
    "The province, such as Málaga"
    province: String
    "The kind of feature, such as Zona encharcable (land that floods) or Barrio (neighbourhood)"
    kind: String
    "Whether the benchmark is a node of the network, such as Línea or no"
    node: String
    "The group of the benchmark"
    group: Int
    "The longitude in ETRS89"
    longitude: Float
    "The latitude in ETRS89"
    latitude: Float
    "The height above the ellipsoid, in metres"
    ellipsoidalHeight: Float
    "The height above sea level, in metres"
    orthometricHeight: Float
    "The address of the PDF that describes the point"
    descriptionSheet: String
    "The levelling line of the benchmark, such as Motril - Málaga"
    line: String
    "The address of the PDF that describes the levelling line"
    lineSheet: String
}

"A page of the levelling benchmarks of the IGN"
type IgnLevellingBenchmarkPage {
    "The number of levelling benchmarks that match, across all pages"
    matched: Int
    "The number of features on this page"
    returned: Int
    "When the service answered"
    timeStamp: DateTime
    "The levelling benchmarks"
    features: [IgnLevellingBenchmark]
}

