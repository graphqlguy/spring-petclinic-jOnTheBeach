    "The UTM northing in ETRS89, in metres"
    utmY: Float
    "The UTM zone, such as 30"
    utmZone: Int
    "The height above sea level, in metres"
    orthometricHeight: Float
    "The address of the PDF that describes the point"
    descriptionSheet: String
}

"A page of the REGENTE geodetic points of the IGN"
type IgnRegenteGeodeticPointPage {
    "The number of REGENTE geodetic points that match, across all pages"
