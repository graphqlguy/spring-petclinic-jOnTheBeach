"The tide gauges of the IGN along the coasts of Spain"
type IgnTideGauge {
    "The id of the feature, for the field that reads one"
    id: ID
    "The geometry of the feature as GeoJSON, in WGS84, or null when the search left it out"
    geometry: JSON
    "The id of the feature before this one in the collection, when one feature is read"
    previousId: String
    "The id of the feature after this one in the collection, when one feature is read"
    nextId: String
