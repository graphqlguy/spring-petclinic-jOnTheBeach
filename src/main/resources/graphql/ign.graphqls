# The fields of the API-Features service of the National Geographic Institute (IGN), at api-features.ign.es. It follows
# the OGC API Features standard and serves administrative units and boundaries, the geographic names of Spain, its
# population centres, and its networks of geodetic points, levelling and tide gauges. A generator wrote one field to
# search each collection and one to read a feature by its id, with their types and
# src/main/resources/ign/operations.json, from the OpenAPI document of the service and from answers recorded from it.
# The names and descriptions are written by hand in English. Each field is fetched by a RestOperationFetcher, see
# IgnConfiguration.

extend type Query {
    # Every collection takes a bounding box, such as -4.50,36.65,-4.35,36.75 for the city of Málaga, and filters on its
    # properties by exact value.

    "The boundaries between administrative units, such as between two municipalities, with their level and legal status"
    ignAdministrativeBoundaries(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
        skipGeometry: Boolean = true
        "Only the administrative boundaries whose gid is this value"
        gid: String
        "Only the administrative boundaries whose nationalCode is this value"
        nationalCode: String
        "Only the administrative boundaries whose country is this value"
        country: String
        "Only the administrative boundaries whose boundaryName is this value"
        boundaryName: String
        "Only the administrative boundaries whose boundaryType is this value"
        boundaryType: String
        "Only the administrative boundaries whose boundaryDate is this value"
        boundaryDate: String
        "Only the administrative boundaries whose documentUrl is this value"
        documentUrl: String
        "Only the administrative boundaries whose nationalLevel is this value"
        nationalLevel: String
        "Only the administrative boundaries whose levelName is this value"
        levelName: String
        "Only the administrative boundaries whose legalStatus is this value"
        legalStatus: String
        "Only the administrative boundaries whose accuracy is this value"
        accuracy: String
        "Only the administrative boundaries whose validUntil is this value"
        validUntil: String
        "Only the administrative boundaries whose legalStatusNilReason is this value"
        legalStatusNilReason: String
        "Only the administrative boundaries whose legalStatusMissing is this value"
        legalStatusMissing: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnAdministrativeBoundaryPage

    "One of the administrative boundaries by its id, with its geometry"
    ignAdministrativeBoundary(
        "The id of the feature, which ignAdministrativeBoundaries gives"
        id: ID!
    ): IgnAdministrativeBoundary

    """
    The administrative units of Spain: the country, the autonomous communities, the provinces and the municipalities,
    with their national codes and NUTS codes. The municipality of Málaga takes nameunit Málaga.
    """
    ignAdministrativeUnits(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
        skipGeometry: Boolean = true
        "Only the administrative units whose gid is this value"
        gid: String
        "Only the administrative units whose country is this value"
        country: String
        "Only the administrative units whose nationalCode is this value"
        nationalCode: String
        "Only the administrative units whose name is this value"
        name: String
        "Only the administrative units whose nuts1 is this value"
        nuts1: String
        "Only the administrative units whose nuts2 is this value"
        nuts2: String
        "Only the administrative units whose nuts3 is this value"
        nuts3: String
        "Only the administrative units whose nationalLevel is this value"
        nationalLevel: String
        "Only the administrative units whose levelName is this value"
        levelName: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnAdministrativeUnitPage

    "One of the administrative units by its id, with its geometry"
    ignAdministrativeUnit(
        "The id of the feature, which ignAdministrativeUnits gives"
        id: ID!
    ): IgnAdministrativeUnit

    """
    The geographic names of Spain from the Nomenclátor Geográfico Básico: towns, hills, rivers, beaches and any other
    named feature, with its kind and source
    """
    ignNamedPlaces(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
        skipGeometry: Boolean = true
        "Only the named places whose identity is this value"
        identity: String
        "Only the named places whose label is this value"
        label: String
        "Only the named places whose kind is this value"
        kind: String
        "Only the named places whose ngbeCode is this value"
        ngbeCode: String
        "Only the named places whose nameType is this value"
        nameType: String
        "Only the named places whose source is this value"
        source: String
        "Only the named places whose date is this value"
        date: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnNamedPlacePage

    "One of the named places by its id, with its geometry"
    ignNamedPlace(
        "The id of the feature, which ignNamedPlaces gives"
        id: ID!
    ): IgnNamedPlace

    """
    The population centres the National Statistics Institute (INE) recognizes, with their number of inhabitants and
    whether each is the capital of its municipality
    """
    ignPopulationCentres(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
