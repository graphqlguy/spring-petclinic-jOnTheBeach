        """
        skipGeometry: Boolean = true
        "Only the population centres whose settlementId is this value"
        settlementId: String
        "Only the population centres whose name is this value"
        name: String
        "Only the population centres whose provinceCode is this value"
        provinceCode: String
        "Only the population centres whose kind is this value"
        kind: String
        "Only the population centres whose inIne is this value"
        inIne: String
        "Only the population centres whose ineCode is this value"
        ineCode: String
        "Only the population centres whose inhabitants is this value"
        inhabitants: String
        "Only the population centres whose entityId is this value"
        entityId: String
        "Only the population centres whose capitalCode is this value"
        capitalCode: String
        "Only the population centres whose rural is this value"
        rural: String
        "Only the population centres whose isolated is this value"
        isolated: String
        "Only the population centres whose latitude is this value"
        latitude: String
        "Only the population centres whose lengthMetres is this value"
        lengthMetres: String
        "Only the population centres whose altitude is this value"
        altitude: String
        "Only the population centres whose date is this value"
        date: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnPopulationCentrePage

    "One of the population centres by its id, with its geometry"
    ignPopulationCentre(
        "The id of the feature, which ignPopulationCentres gives"
        id: ID!
    ): IgnPopulationCentre

    """
    The settlements that the INE does not count as population centres, such as scattered houses, with their inhabitants
    """
    ignOtherSettlements(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
        skipGeometry: Boolean = true
        "Only the other settlements whose settlementId is this value"
        settlementId: String
        "Only the other settlements whose name is this value"
        name: String
        "Only the other settlements whose provinceCode is this value"
        provinceCode: String
        "Only the other settlements whose kind is this value"
        kind: String
        "Only the other settlements whose inIne is this value"
        inIne: String
        "Only the other settlements whose ineCode is this value"
        ineCode: String
        "Only the other settlements whose inhabitants is this value"
        inhabitants: String
        "Only the other settlements whose entityId is this value"
        entityId: String
        "Only the other settlements whose capitalCode is this value"
        capitalCode: String
        "Only the other settlements whose rural is this value"
        rural: String
        "Only the other settlements whose isolated is this value"
        isolated: String
        "Only the other settlements whose latitude is this value"
        latitude: String
        "Only the other settlements whose lengthMetres is this value"
        lengthMetres: String
        "Only the other settlements whose altitude is this value"
        altitude: String
        "Only the other settlements whose date is this value"
        date: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnOtherSettlementPage

    "One of the other settlements by its id, with its geometry"
    ignOtherSettlement(
        "The id of the feature, which ignOtherSettlements gives"
        id: ID!
    ): IgnOtherSettlement

    "The inhabited places without a known name"
    ignUnnamedSettlements(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
        skipGeometry: Boolean = true
        "Only the unnamed settlements whose seigId is this value"
        seigId: String
        "Only the unnamed settlements whose settlementId is this value"
        settlementId: String
        "Only the unnamed settlements whose name is this value"
        name: String
        "Only the unnamed settlements whose provinceCode is this value"
        provinceCode: String
        "Only the unnamed settlements whose date is this value"
        date: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnUnnamedSettlementPage

    "One of the unnamed settlements by its id, with its geometry"
    ignUnnamedSettlement(
        "The id of the feature, which ignUnnamedSettlements gives"
        id: ID!
    ): IgnUnnamedSettlement

    "The permanent GNSS reference stations of the IGN (ERGNSS), with their positions and the networks they belong to"
    ignGnssStations(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
        skipGeometry: Boolean = true
        "Only the GNSS reference stations whose code is this value"
        code: String
        "Only the GNSS reference stations whose name is this value"
        name: String
        "Only the GNSS reference stations whose iersCode is this value"
        iersCode: String
        "Only the GNSS reference stations whose installed is this value"
        installed: String
        "Only the GNSS reference stations whose municipality is this value"
        municipality: String
        "Only the GNSS reference stations whose province is this value"
        province: String
        "Only the GNSS reference stations whose location is this value"
        location: String
        "Only the GNSS reference stations whose lengthMetres is this value"
        lengthMetres: String
        "Only the GNSS reference stations whose latitude is this value"
        latitude: String
        "Only the GNSS reference stations whose ellipsoidalHeight is this value"
        ellipsoidalHeight: String
        "Only the GNSS reference stations whose cartesianX is this value"
        cartesianX: String
        "Only the GNSS reference stations whose cartesianY is this value"
        cartesianY: String
        "Only the GNSS reference stations whose cartesianZ is this value"
        cartesianZ: String
        "Only the GNSS reference stations whose utmX is this value"
        utmX: String
        "Only the GNSS reference stations whose utmY is this value"
        utmY: String
        "Only the GNSS reference stations whose utmZone is this value"
        utmZone: String
        "Only the GNSS reference stations whose orthometricHeight is this value"
        orthometricHeight: String
        "Only the GNSS reference stations whose mainNetwork is this value"
        mainNetwork: String
        "Only the GNSS reference stations whose otherNetworks is this value"
        otherNetworks: String
        "Only the GNSS reference stations whose descriptionSheet is this value"
        descriptionSheet: String
        "Only the GNSS reference stations whose logUrl is this value"
        logUrl: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnGnssStationPage

    "One of the GNSS reference stations by its id, with its geometry"
    ignGnssStation(
        "The id of the feature, which ignGnssStations gives"
        id: ID!
    ): IgnGnssStation

    "The benchmarks of the high precision levelling network of Spain (REDNAP), with their heights"
    ignLevellingBenchmarks(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
        skipGeometry: Boolean = true
        "Only the levelling benchmarks whose number is this value"
        number: String
        "Only the levelling benchmarks whose name is this value"
        name: String
        "Only the levelling benchmarks whose municipality is this value"
        municipality: String
        "Only the levelling benchmarks whose province is this value"
        province: String
        "Only the levelling benchmarks whose kind is this value"
        kind: String
        "Only the levelling benchmarks whose node is this value"
        node: String
        "Only the levelling benchmarks whose group is this value"
        group: String
        "Only the levelling benchmarks whose longitude is this value"
        longitude: String
        "Only the levelling benchmarks whose latitude is this value"
        latitude: String
        "Only the levelling benchmarks whose ellipsoidalHeight is this value"
        ellipsoidalHeight: String
        "Only the levelling benchmarks whose orthometricHeight is this value"
        orthometricHeight: String
        "Only the levelling benchmarks whose descriptionSheet is this value"
        descriptionSheet: String
        "Only the levelling benchmarks whose line is this value"
        line: String
        "Only the levelling benchmarks whose lineSheet is this value"
        lineSheet: String
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of results on a page, from 1 to 100"
        size: Int! = 10
    ): IgnLevellingBenchmarkPage

    "One of the levelling benchmarks by its id, with its geometry"
    ignLevellingBenchmark(
        "The id of the feature, which ignLevellingBenchmarks gives"
        id: ID!
    ): IgnLevellingBenchmark

    "The points of the national geodetic network by space techniques (REGENTE), with their coordinates"
    ignRegenteGeodeticPoints(
        """
        Only the features inside this box, written as minLongitude,minLatitude,maxLongitude,maxLatitude, such as
        -4.50,36.65,-4.35,36.75 for the city of Málaga
        """
        bbox: String
        """
        false for the geometry of each feature, which can be long for lines and areas. true, the default, leaves it out.
        """
