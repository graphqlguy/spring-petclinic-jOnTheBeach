# The fields of Mosquito Alert, the citizen science project of the CEAB-CSIC and its partners, at api.mosquitoalert.com.
# A generator wrote them, their types and src/main/resources/mosquitoalert/operations.json from the OpenAPI document of
# the service, one field for each read operation that works without signing in. The descriptions are written by hand,
# from the ones in the OpenAPI document. Each field is fetched by a RestOperationFetcher, see
# MosquitoAlertConfiguration.

extend type Query {
    # People send Mosquito Alert photos of mosquitoes, their bites and the places where mosquitoes breed, and experts
    # identify the species. The tiger mosquito (Aedes albopictus) carries the heartworm of dogs and cats, so its reports
    # near an owner matter to a clinic.

    """
    Reports of mosquitoes that people sent to Mosquito Alert with a photo, newest first, filtered by place, day and
    species. Each one says where and when the mosquito was seen, and which species the experts identified. For the tiger
    mosquitoes reported within 30 km of Málaga this year, pass near -4.4214,36.7213, distanceInMetres 30000, taxonIds
    [112] and createdAfter 2026-01-01.
    """
    mosquitoAlertObservations(
        """
        The centre of the search as longitude,latitude, in that order, such as -4.4214,36.7213 for the centre of Málaga.
        Give distanceInMetres with it.
        """
        near: String
        "How far from near to search, in metres, such as 20000 for 20 km"
        distanceInMetres: Float
        "Only the reports from this country, by its id: 17 for Spain"
        countryId: Int
        "Only the reports made on or after this day, such as 2026-01-01"
        createdAfter: Date
        "Only the reports made on or before this day"
        createdBefore: Date
        "true for the reports with at least one photo"
        hasPhotos: Boolean
        """
        Only the reports identified as one of these taxa, by the ids mosquitoAlertTaxa gives: 112 for the tiger mosquito
        (Aedes albopictus), 113 for the yellow fever mosquito (Aedes aegypti), 10 for the common mosquito (Culex)
        """
        taxonIds: [Int!]
        "The order of the reports. The newest come first by default."
        orderBy: MosquitoAlertOrder
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of reports on a page, from 1 to 100"
        size: Int! = 10
    ): MosquitoAlertObservationPage

    "One report of a mosquito by its id, with its photos and the identification of the experts"
    mosquitoAlertObservation(
        "The id of the report, a UUID that mosquitoAlertObservations gives"
        id: ID!
    ): MosquitoAlertObservation

    """
    Reports of mosquito bites that people sent to Mosquito Alert, newest first, filtered by place and day, with the
    number of bites on each part of the body
    """
    mosquitoAlertBites(
        """
        The centre of the search as longitude,latitude, in that order, such as -4.4214,36.7213 for the centre of Málaga.
        Give distanceInMetres with it.
        """
        near: String
        "How far from near to search, in metres, such as 20000 for 20 km"
        distanceInMetres: Float
        "Only the reports from this country, by its id: 17 for Spain"
        countryId: Int
        "Only the reports made on or after this day, such as 2026-01-01"
        createdAfter: Date
        "Only the reports made on or before this day"
        createdBefore: Date
        "The order of the reports. The newest come first by default."
        orderBy: MosquitoAlertOrder
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of reports on a page, from 1 to 100"
        size: Int! = 10
    ): MosquitoAlertBitePage

    "One report of mosquito bites by its id"
    mosquitoAlertBite(
        "The id of the report, a UUID that mosquitoAlertBites gives"
        id: ID!
    ): MosquitoAlertBite

    """
    Reports of places where mosquitoes breed, such as a storm drain or a bucket of standing water, that people sent to
    Mosquito Alert, newest first, filtered by place, day and kind of site
    """
    mosquitoAlertBreedingSites(
        """
        The centre of the search as longitude,latitude, in that order, such as -4.4214,36.7213 for the centre of Málaga.
        Give distanceInMetres with it.
        """
        near: String
        "How far from near to search, in metres, such as 20000 for 20 km"
        distanceInMetres: Float
        "Only the reports from this country, by its id: 17 for Spain"
        countryId: Int
        "Only the reports made on or after this day, such as 2026-01-01"
        createdAfter: Date
        "Only the reports made on or before this day"
        createdBefore: Date
        "true for the reports with at least one photo"
        hasPhotos: Boolean
        "Only these kinds of site"
        siteTypes: [MosquitoAlertBreedingSiteType!]
        "true for the sites where the person saw water"
        hasWater: Boolean
        "true for the sites where the person saw larvae"
        hasLarvae: Boolean
        "true for the sites where the person saw mosquitoes within 10 metres"
        hasMosquitoesNear: Boolean
        "The order of the reports. The newest come first by default."
        orderBy: MosquitoAlertOrder
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of reports on a page, from 1 to 100"
        size: Int! = 10
    ): MosquitoAlertBreedingSitePage

    "One report of a place where mosquitoes breed, by its id"
    mosquitoAlertBreedingSite(
        "The id of the report, a UUID that mosquitoAlertBreedingSites gives"
        id: ID!
    ): MosquitoAlertBreedingSite

    """
    The places and days of the reports of mosquitoes within a distance of a point, with the taxon the experts
    identified, as light points for a map. The answer has every matching report on one page, so keep the distance small,
    such as 10000 metres, or narrow the days.
    """
    mosquitoAlertObservationPoints(
        "The centre of the search as longitude,latitude, such as -4.4214,36.7213 for Málaga"
        near: String!
        "How far from near to search, in metres, such as 10000"
        distanceInMetres: Float!
        "Only the reports made on or after this day, such as 2026-01-01"
        createdAfter: Date
        "Only the reports made on or before this day"
        createdBefore: Date
        "Only the reports identified as one of these taxa, such as 112 for the tiger mosquito"
        taxonIds: [Int!]
    ): [MosquitoAlertObservationPoint]

    """
    The places and days of the reports of mosquito bites within a distance of a point, as light points for a map. The
    answer has every matching report on one page, so keep the distance small.
    """
    mosquitoAlertBitePoints(
        "The centre of the search as longitude,latitude, such as -4.4214,36.7213 for Málaga"
        near: String!
        "How far from near to search, in metres, such as 10000"
        distanceInMetres: Float!
        "Only the reports made on or after this day, such as 2026-01-01"
        createdAfter: Date
        "Only the reports made on or before this day"
        createdBefore: Date
    ): [MosquitoAlertReportPoint]

    """
    The places and days of the reports of places where mosquitoes breed within a distance of a point, as light points
    for a map. The answer has every matching report on one page, so keep the distance small.
    """
    mosquitoAlertBreedingSitePoints(
        "The centre of the search as longitude,latitude, such as -4.4214,36.7213 for Málaga"
        near: String!
        "How far from near to search, in metres, such as 10000"
        distanceInMetres: Float!
        "Only the reports made on or after this day, such as 2026-01-01"
        createdAfter: Date
        "Only the reports made on or before this day"
        createdBefore: Date
    ): [MosquitoAlertBreedingSitePoint]

    """
    The taxa the experts identify mosquitoes as, such as the species Aedes albopictus (the tiger mosquito) or the genus
    Culex, with their ids for the taxonIds argument of mosquitoAlertObservations
    """
    mosquitoAlertTaxa(
        "Only the taxa of these ranks"
        ranks: [MosquitoAlertTaxonRank!]
        """
        true for the taxa the project watches, such as the tiger mosquito. These are the ones a question about
        mosquitoes needs.
        """
        relevant: Boolean
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of taxa on a page, from 1 to 100"
        size: Int! = 10
    ): MosquitoAlertTaxonPage

    "One taxon by its id, such as 112 for the tiger mosquito"
    mosquitoAlertTaxon(
        "The id of the taxon, such as 112"
        id: ID!
    ): MosquitoAlertTaxon

    """
    One taxon with the taxa below it, such as the genus Aedes with its species. Select children inside children for the
    levels below.
    """
    mosquitoAlertTaxonTree(
        "The id of the taxon at the top of the tree"
        id: ID!
    ): MosquitoAlertTaxonTreeNode

    """
    The whole tree of the taxa the experts use, from the class of insects down to the species. Select children inside
    children for the levels below.
    """
    mosquitoAlertTaxonRoot: MosquitoAlertTaxonTreeNode
}

"Where and when a mosquito was reported, as a light point for a map"
type MosquitoAlertObservationPoint {
    "The id of the report, which mosquitoAlertObservation reads"
    id: ID
    "The latitude"
    latitude: Float
    "The longitude"
    longitude: Float
    "When Mosquito Alert received the report"
    received: DateTime
    """
    The taxon the experts identified, by the id mosquitoAlertTaxa gives, such as 112 for the tiger mosquito (Aedes
    albopictus), or null
    """
    taxonId: Int
}

"Where and when a breeding site was reported, as a light point for a map"
type MosquitoAlertBreedingSitePoint {
    "The id of the report, which mosquitoAlertBreedingSite reads"
    id: ID
    "The latitude"
    latitude: Float
    "The longitude"
    longitude: Float
    "When Mosquito Alert received the report"
    received: DateTime
    "The kind of site, such as storm_drain"
    siteType: String
    "Whether the person saw water"
    hasWater: Boolean
}

"Where and when a bite was reported, as a light point for a map"
type MosquitoAlertReportPoint {
    "The id of the report"
    id: ID
    "The latitude"
    latitude: Float
    "The longitude"
    longitude: Float
    "When Mosquito Alert received the report"
    received: DateTime
}

"One page of reports of mosquitoes"
type MosquitoAlertObservationPage {
    "The number of reports that match, across all pages"
    totalCount: Int
    "The reports on this page"
    results: [MosquitoAlertObservation]
}

"A report of a mosquito that a person sent with a photo. The experts of the project identify the species in the photo."
type MosquitoAlertObservation {
    "The id of the report, a UUID"
    id: ID
    "A short code for the report, such as QuEI, which the app shows its sender"
    shortId: String
    "When the person made the report, in UTC"
    createdAt: DateTime
    """
    When the person made the report, in the local time of the place, written without an offset, such as
    2026-10-07T13:48:56
    """
    createdAtLocal: String
    "When the app sent the report"
    sentAt: DateTime
    "When the server received the report"
    receivedAt: DateTime
    "When the report last changed, for example when experts identified it"
    updatedAt: DateTime
    "Where the report was made"
    location: MosquitoAlertLocation
    "What the person wrote with the report, in their language, or null"
    note: String
    "The tags of the report, which campaigns use"
    tags: [String]
    "Whether the report is public"
    published: Boolean
    "Where it happened: indoors, outdoors or vehicle, or an empty text when the person did not say"
    environment: String
    "When in the day it happened, such as now or last_morning, or an empty text when the person did not say"
    moment: String
    "The photos of the mosquito"
    photos: [MosquitoAlertPhoto]
    """
    Which species the experts or the model identified in the photos, and how sure they are. Null until someone has
    looked at it.
    """
    identification: MosquitoAlertIdentification
    "What the person said the mosquito looked like, or null"
    appearance: MosquitoAlertAppearance
}

