"Where a report was made"
type MosquitoAlertLocation {
    "How the app found the place: auto for the phone's GPS, manual when the person picked it on a map"
    source: String
    "The latitude and longitude of the place"
    point: MosquitoAlertPoint
    "The time zone of the place, such as Europe/Madrid"
    timezone: String
    "The name of the place, such as Málaga, Málaga, Andalucía, Spain"
    displayName: String
    "The country of the place"
    country: MosquitoAlertCountry
    """
    The regions the place lies in, from the widest to the narrowest, such as Andalucía, then the province of Málaga,
    then the town
    """
    administrativeAreas: [MosquitoAlertAdministrativeArea]
}

"A point on the map"
type MosquitoAlertPoint {
    "The latitude, such as 36.72 in Málaga"
    latitude: Float
    "The longitude, such as -4.42 in Málaga"
    longitude: Float
}

"A country"
type MosquitoAlertCountry {
    "The id of the country, for the countryId argument: 17 for Spain"
    id: Int
    "The name of the country in English, such as Spain"
    name: String
    "The three-letter ISO 3166-1 code of the country, such as ESP"
    iso3Code: String
}

"A region a place lies in, as the NUTS classification of Eurostat names it"
type MosquitoAlertAdministrativeArea {
    "The name of the region, such as Andalucía"
    name: String
    "The code of the region, such as ES61 for Andalucía or ES617 for Málaga"
    code: String
    "The classification the code comes from, such as NUTS"
    source: String
    "How narrow the region is: 2 for a region such as Andalucía, 3 for a province, 4 for a town"
    level: Int
}

"A photo sent with a report"
type MosquitoAlertPhoto {
    "The id of the photo, a UUID"
    id: ID
    "The address of the photo. It can change over time, so read it again before use."
    url: String
}

"Which species the experts or the model identified in the photos of a report"
type MosquitoAlertIdentification {
    "The photo the identification is based on"
    photo: MosquitoAlertPhoto
    "How many experts annotated the report"
    annotations: Int
    "The species and how sure the identification is"
    result: MosquitoAlertIdentificationResult
    "What the experts wrote to the person, in their language, or null"
    publicNote: String
}

"The outcome of an identification"
type MosquitoAlertIdentificationResult {
    "Who identified the species: expert for the experts, ai for the model"
    source: String
    "The species or genus identified, such as Aedes albopictus"
    taxon: MosquitoAlertTaxon
    "Whether the identification is sure enough to rely on"
    highConfidence: Boolean
    "How sure the identification is, from 0 to 1"
    confidence: Float
    "How sure the identification is, in words, such as Confirmed"
    confidenceLabel: String
    "How uncertain the identification is, from 0 to 1"
    uncertainty: Float
    "How much the experts agreed, from 0 to 1"
    agreement: Float
    "The sex of the mosquito and whether it had fed, when the experts could tell"
    characteristics: MosquitoAlertCharacteristics
}

"What the experts could tell about one mosquito"
type MosquitoAlertCharacteristics {
    "female or male. Only females bite."
    sex: String
    "Whether the mosquito had fed on blood, or null"
    bloodFed: Boolean
    "Whether the mosquito carried eggs, or null"
    gravid: Boolean
}

"What the person said a mosquito looked like, by the species each part of its body resembles"
type MosquitoAlertAppearance {
    "The species the person thought it was, in lower case, such as albopictus or culex"
    species: String
    "The species whose thorax it resembles"
    thorax: String
    "The species whose abdomen it resembles"
    abdomen: String
    "The species whose legs it resembles"
    legs: String
}

"One page of taxa"
type MosquitoAlertTaxonPage {
    "The number of taxa that match, across all pages"
    totalCount: Int
    "The taxa on this page"
    results: [MosquitoAlertTaxon]
}

"A species, genus or other taxon that experts identify mosquitoes as"
type MosquitoAlertTaxon {
    "The id of the taxon, for the taxonIds argument of mosquitoAlertObservations"
    id: Int
    "The scientific name, such as Aedes albopictus"
    name: String
    "The common name in English, such as Tiger mosquito, or null"
    commonName: String
    "The rank of the taxon, in lower case, such as species, species_complex or genus"
    rank: String
    "Whether the name is written in italics, as scientific names of species are"
    italicize: Boolean
    "Whether the project watches this taxon, as it does the tiger mosquito"
    relevant: Boolean
}

"A taxon with the taxa below it"
type MosquitoAlertTaxonTreeNode {
    "The id of the taxon"
    id: Int
    "The scientific name, such as Culicidae"
    name: String
    "The common name in English, or null"
    commonName: String
    "The rank of the taxon, in lower case, such as family or genus"
    rank: String
    "Whether the name is written in italics"
    italicize: Boolean
    "Whether the project watches this taxon"
    relevant: Boolean
    "The taxa one rank below this one"
    children: [MosquitoAlertTaxonTreeNode]
}

"The order of a list of Mosquito Alert reports"
enum MosquitoAlertOrder {
    "The newest reports first"
    NEWEST_FIRST
    "The oldest reports first"
    OLDEST_FIRST
    "The reports nearest to the point first. Needs near."
    NEAREST_FIRST
    "The reports farthest from the point first. Needs near."
    FARTHEST_FIRST
    "The reports the server received last first"
    LAST_RECEIVED_FIRST
    "The reports the server received first first"
    FIRST_RECEIVED_FIRST
}

"A kind of place where mosquitoes breed"
enum MosquitoAlertBreedingSiteType {
    "A basin or pond"
    BASIN
    "A bucket"
    BUCKET
    "A fountain"
    FOUNTAIN
    "A small container, such as a flower pot saucer"
    SMALL_CONTAINER
    "A storm drain"
    STORM_DRAIN
    "A well"
    WELL
    "Any other place"
    OTHER
}

"The rank of a taxon, from the widest to the narrowest"
enum MosquitoAlertTaxonRank {
    "A class, such as Insecta"
    CLASS
    "An order, such as Diptera"
    ORDER
    "A family, such as Culicidae"
    FAMILY
    "A genus, such as Aedes"
    GENUS
    "A subgenus"
    SUBGENUS
    "A group of species that look alike in photos"
    SPECIES_COMPLEX
    "A species, such as Aedes albopictus"
    SPECIES
}
