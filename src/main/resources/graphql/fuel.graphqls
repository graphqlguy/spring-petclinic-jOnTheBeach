"A fuel the stations report"
type FuelProduct {
    "The id of the fuel, such as 1, which the enum FuelKind names for the product arguments"
    id: ID
    "The name of the fuel, such as Gasolina 95 E5 or Gasóleo A habitual"
    name: String
    "The short name of the fuel, such as G95E5"
    abbreviation: String
}

"An autonomous community of Spain"
type FuelRegion {
    "The id of the community, such as 01 for Andalusia"
    id: ID
    "The name, such as Andalucia"
    name: String
}

"A province of Spain"
type FuelProvince {
    "The id of the province, for the provinceId arguments, such as 29 for Málaga"
    id: ID
    "The name, in capitals, such as MÁLAGA"
    name: String
    "The id of its autonomous community"
    regionId: ID
    "The name of its autonomous community"
    region: String
}

"A municipality of Spain, as the ministry lists it"
type FuelMunicipality {
    "The id of the municipality, for the municipalityId arguments, such as 4521 for Málaga"
    id: ID
    "The name, such as Málaga"
    name: String
    "The id of its province"
    provinceId: ID
    "The name of its province, in capitals"
    province: String
    "The id of its autonomous community"
    regionId: ID
    "The name of its autonomous community"
    region: String
}

"A fuel the stations sell. The ministry gives each one an id, such as 4 for DIESEL_A."
enum FuelKind {
    "Gasolina 95 E5, the usual unleaded petrol"
    GASOLINE_95_E5
    "Gasolina 95 E10"
    GASOLINE_95_E10
    "Gasolina 95 E25"
    GASOLINE_95_E25
    "Gasolina 95 E85"
    GASOLINE_95_E85
    "Gasolina 95 E5 Premium"
    GASOLINE_95_E5_PREMIUM
    "Gasolina 98 E5"
    GASOLINE_98_E5
    "Gasolina 98 E10"
    GASOLINE_98_E10
    "Gasóleo A habitual, the usual diesel for cars"
    DIESEL_A
    "Gasóleo Premium"
    DIESEL_PREMIUM
    "Gasóleo B, the diesel for farm machinery"
    DIESEL_B
    "Gasóleo C, the diesel for heating"
    DIESEL_C
    "Bioetanol"
    BIOETHANOL
    "Biodiésel"
    BIODIESEL
    "Gases licuados del petróleo (autogas)"
    LPG
    "Gas natural comprimido"
    CNG
    "Gas natural licuado"
    LNG
    "Hidrógeno"
    HYDROGEN
    "Fuelóleo bajo índice azufre"
    LOW_SULPHUR_FUEL_OIL
    "Fuelóleo especial"
    SPECIAL_FUEL_OIL
    "Gasóleo para uso marítimo"
    MARINE_DIESEL
    "Gasolina de aviación"
    AVIATION_GASOLINE
    "Queroseno de aviación JET_A1"
    JET_A1
    "Queroseno de aviación JET_A2"
    JET_A2
    "Adblue"
    ADBLUE
    "Diésel renovable"
    RENEWABLE_DIESEL
    "Gasolina renovable"
    RENEWABLE_GASOLINE
    "Metanol"
    METHANOL
    "Amoniaco"
    AMMONIA
    "Biogas natural comprimido"
    COMPRESSED_BIOGAS
    "Biogas natural licuado"
    LIQUEFIED_BIOGAS
}
