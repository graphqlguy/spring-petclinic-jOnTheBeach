    "What it is used for, such as DOCENTE (teaching) or AGROPECUARIO (farming)"
    usage: String
    "The street or place"
    street: String
    "The municipality, in capitals and without accents"
    municipality: String
    "The province"
    province: String
    "The number of the property in the inventory of the Junta"
    inventoryNumber: Float
    "The address of the record in the catalogue of the Junta"
    resource: String
    "The id of the record in the content system of the Junta"
    catalogueId: String
    "The collection of the record, jda_buscador_bienes_inmuebles"
    collection: String
    "Whether the record is published"
    available: Boolean
    "When the record last changed"
    modified: DateTime
}

"A course of the Andalusian Institute of Historical Heritage (IAPH)"
type JuntaHeritageCourse {
    "The id of the course"
    id: ID
    "The title, in Spanish"
    title: String
    "The discipline, such as Museos"
    discipline: String
    "Teleformación (online), Presencial (in a classroom) or Mixta"
    modality: String
    "The first day, such as 2026-11-16"
    start: String
    "The last day"
    end: String
    "The first day to register"
    registrationStart: String
    "The last day to register"
    registrationEnd: String
    "The place of a course in a classroom, such as SEVILLA"
    location: String
    "The province of the place"
    province: String
    "The length of the course, in hours"
    hours: Int
    "The number of places"
    capacity: Int
    "The name of the file with the programme"
    program: String
    "The name of the image of the course, when it has one"
    image: String
    "Whether the record is published"
    available: Boolean
}

"A valuation table: how long the archives keep one series of public documents"
type JuntaRatingTable {
    "The code of the table"
    code: String
    "The administration that produces the documents: A (autonomous), E (state), J (justice) or L (local)"
    administration: String
    "The series of documents, such as Expedientes del Impuesto de Transmisiones Patrimoniales"
    series: String
    "What happens to the documents, such as ET a los 5 años (destroyed in full after five years)"
    resolution: String
    "The first day of the period the table studied, such as 1987-01-01"
    periodStart: String
    "The last day of the period the table studied"
    periodEnd: String
    "The last day of documents the table applies to, when it has one"
    limit: String
    "The days the orders that approved the table were signed"
    approvals: [String]
    "The files of the table"
