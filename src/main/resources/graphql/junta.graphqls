    "The day of the holiday as a number, such as 20260101 for 1 January 2026"
    dayNumber: Int
    "The holiday, in Spanish, such as AÑO NUEVO or FIESTA LOCAL EN MÁLAGA (MÁLAGA)"
    description: String
    "LOCAL for a holiday of one town, LABORAL for a national or regional one"
    kind: String
    "The municipality of a local holiday, in capitals, or an empty text"
    municipality: String
    "The province of a local holiday, in capitals, or an empty text"
    province: String
    "The year, such as 2026"
    year: String
}

"A municipality of Andalusia"
type JuntaMunicipality {
