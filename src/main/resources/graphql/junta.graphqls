    "The company that holds it"
    contractor: String
    "The amount, in euros"
    amount: Float
}

"A grant for institutional advertising. The dataset also names the beneficiary, which this schema leaves out."
type JuntaAdvertisingGrant {
    "The grant"
    name: String
    "The amount, in euros"
    amount: Float
}

"A document with its title and address"
type JuntaDocumentLink {
    "The title"
    title: String
    "The address"
    url: String
}

"The syllabus in force for the exam of one specialty of the civil service"
type JuntaSyllabus {
    "The id of the syllabus"
    id: ID
    "The title, such as A1.2021 Arqueología - Temario"
    title: String
    "Which parts it has, such as Común y específico (common and specific)"
    kind: String
    "The specialties and bodies of civil servants it is for"
    specialties: [JuntaStaffSpecialty]
    "The files of the syllabus"
    files: [JuntaMediaFile]
    "When it was published, in seconds since 1970"
    created: String
    "When it last changed, in seconds since 1970"
    changed: String
}

"A specialty of the civil service of the Junta and the body it belongs to"
type JuntaStaffSpecialty {
    "The specialty, such as A1.2012 Especialidad Veterinaria"
    specialty: String
    "The body or group of civil servants"
    groups: [JuntaStaffGroup]
}

"A body or group of civil servants of the Junta"
type JuntaStaffGroup {
    "The body or group, such as A1.2 Cuerpo Superior Facultativo"
    name: String
    "The kind of staff"
    staff: [JuntaStaffKind]
}

"A kind of staff of the Junta"
type JuntaStaffKind {
    "The kind of staff, such as Personal Funcionario (Junta de Andalucía)"
    name: String
    "The scope, such as Función Pública de la Junta de Andalucía"
    scopes: [String]
}

"A selection process to join the civil service of the Junta de Andalucía"
type JuntaSelectionProcess {
    "The id of the process"
    id: ID
    "The years of the public employment offers it belongs to"
    offerYears: [String]
    "How candidates enter"
    access: [JuntaProcessAccess]
    "The specialties and bodies it fills"
    specialties: [JuntaStaffSpecialty]
    "Where the process stands"
    statuses: [JuntaProcessStatus]
    "The number of places"
    vacancies: Int
    "The places for any candidate"
    generalVacancies: Int
    "The places for people with a disability"
    disabilityVacancies: Int
    "The places for people with an intellectual disability"
    intellectualDisabilityVacancies: Int
    "The places for people with a mental illness"
    illnessVacancies: Int
    "The resolution that called the process"
    call: JuntaDocumentLink
    "The steps of the process and the questions about them"
    steps: [JuntaProcessStep]
    "The path of its page on www.juntadeandalucia.es"
    path: String
    "When it was published, in seconds since 1970"
    created: String
    "When it last changed, in seconds since 1970"
    changed: String
}

"How candidates enter a selection process"
type JuntaProcessAccess {
    "The kind of access, such as Ordinaria"
    access: String
    "The wider kind, such as Promoción interna (internal promotion)"
    parents: [String]
}

"Where a selection process stands"
type JuntaProcessStatus {
    "The status, such as En proceso publicación de personas admitidas y excluidas"
    status: String
    "The phase, such as Fase de solicitud de participación"
    phases: [String]
}

"A step of a selection process, or a question about it"
type JuntaProcessStep {
    "The title, such as Presentación de solicitudes."
    title: String
    "The address of the document or page"
    url: String
    "1 when the step is a questionnaire, otherwise 0"
    questionnaire: String
}

"A task a body of the Junta assigns to one of its own public companies or agencies"
type JuntaAssignment {
    "The id of the assignment"
    id: ID
    "The title, in Spanish"
    title: String
    "The bodies involved"
    organisms: [String]
    "The day it was published, such as 07/08/2020"
    published: String
    "The budget, in euros, as the dataset writes it"
    budget: String
    "How long it lasts, in words"
    duration: String
    "What is assigned, as HTML"
    objective: String
    "What it costs each year, as HTML"
    economicObligation: String
    "The documents of the assignment"
    documents: [JuntaAssignmentDocument]
    "When the record last changed"
    updated: DateTime
}

"A document of an assignment"
type JuntaAssignmentDocument {
    "The title"
    title: String
    "The files"
    files: [JuntaFileList]
}

"A resolution by which a body of the Junta delegates some of its powers"
type JuntaDelegation {
    "The id of the delegation"
    id: ID
    "The title, in Spanish"
    title: String
    "The bodies involved"
    organisms: [String]
    "The day of the delegation, such as 31/07/2026"
    delegated: String
    "The addresses of the resolution in the official gazette (BOJA)"
    documents: [String]
    "published once it is public"
    state: String
    "The path of its page on www.juntadeandalucia.es"
    path: String
    "When the record last changed"
    updated: DateTime
}

"A decision of the Administrative Court of Contract Appeals of Andalusia"
type JuntaTenderCourtDecision {
    "The id of the decision"
    id: ID
    "The title, such as Resolución 255/2016"
    title: String
    "What the decision is about, in Spanish"
    description: String
    "The number of the appeal, such as 214/2016"
    appealNumber: String
    "The number and day of the decision"
    resolutions: [JuntaTenderCourtResolution]
    "The kinds of contract, such as Servicio"
    contractKinds: [String]
    "The acts appealed, such as Adjudicación (award)"
    contestedActs: [String]
    "The outcome, such as Desestimación (dismissed)"
    outcomes: [String]
    "The files of the decision"
    files: [JuntaTenderCourtFile]
}

"The number and day of a decision of the court"
type JuntaTenderCourtResolution {
    "The number, such as 255/2016"
    number: String
    "The day, such as 2026-09-30"
    date: String
}

"The files of a decision of the court"
type JuntaTenderCourtFile {
    "The files"
    files: [JuntaMediaList]
}

"A job position in the list of job positions of the Junta de Andalucía"
type JuntaJobPosition {
    "The code of the position"
    id: ID
    "The position, in capitals, such as A.T.-MEDICAMENTOS VETERINARIOS"
    description: String
    "The organization, such as AGRICULTURA, PESCA, AGUA Y DESARR. RURAL"
    organization: String
    "The department, such as D.G. PRODUC.AGRICOLA Y GANADERA"
    department: String
    "The department the position works for"
    targetDepartment: String
    "The town, such as SEVILLA"
    town: String
    "The groups of civil servants that can hold it, such as A1-A2"
    group: String
    "The level code, such as P-A12"
    subgroup: String
    "F for civil servants, L for staff with an employment contract"
    adscription: String
    "How it is filled, such as PC (competition of merits)"
    accessType: String
    "The functional area, such as ADM. AGRARIA"
    functionalArea: String
    "The professional category, for staff with an employment contract"
    professionalCategory: String
    "The degree it asks for, such as LDO/A. VETERINARIA"
    degree: String
    "The training it asks for"
    training: String
    "The number of positions with this description"
    positions: Int
    "The specific pay supplement, in euros a year"
    specificComplement: Float
    "The lowest cost of the position, in euros a year"
    lowerCost: Float
    "The highest cost of the position, in euros a year"
    upperCost: Float
    "The code of the department, such as 23"
    cdce: String
    "The kind of administration, when the dataset gives it"
    administrationType: String
}

"""
A unit of the organic structure of the Junta de Andalucía, such as a directorate general or a public foundation. The
dataset also names the head of each unit with a biography, and gives phone numbers and e-mail addresses, which this
schema leaves out.
"""
type JuntaOrganicStructureUnit {
    "The id of the unit"
    id: ID
    "The name of the unit"
    title: String
    "The department it belongs to"
    department: String
    "What the unit does, as HTML"
    functions: String
    "Its code in DIR3, the common directory of the administrations, which juntaOrganicUnit reads"
    dir3Code: String
    "The address of its record in DIR3"
    dir3Reference: String
    "The addresses of its seat"
    seats: [JuntaUnitSeat]
    "The regulations that created it or set its functions"
    regulations: [JuntaReferenceRegulation]
    "The units within it"
    subunits: [JuntaSubunit]
    "published once it is public"
    state: String
}

"A unit within a unit of the organic structure. The dataset also names its head, which this schema leaves out."
type JuntaSubunit {
    "The name, such as Unidad de Control Interno"
    name: String
}

"The address of the seat of a unit"
type JuntaUnitSeat {
    "The name of the building or body, when it differs from the unit"
    name: String
    "The address, such as C/ Altozano, 9"
    address: String
    "The town and province, such as Almonte (Huelva)"
    location: String
    "The postcode"
    postcode: String
}

"A regulation that concerns a unit"
type JuntaReferenceRegulation {
    "The title"
    title: String
    "The address of the regulation in the official gazette"
    url: String
}

"""
A transparency unit of the Junta de Andalucía, which answers requests for public information about the bodies it serves.
The dataset also names the person in charge with a phone number, which this schema leaves out.
"""
type JuntaTransparencyUnit {
    "The id of the unit"
    id: ID
    "The name of the unit"
    title: String
    "The bodies it serves"
    scopes: [String]
    "The e-mail addresses of the unit"
    contacts: [JuntaTransparencyContact]
}

"The e-mail address of a transparency unit"
type JuntaTransparencyContact {
    "The e-mail address, such as unidadtransparencia@andaluciatrade.es"
    email: String
}

"An activity in which a body of the Junta de Andalucía processes personal data"
type JuntaDataProcessingActivity {
    "The id of the activity"
    id: ID
    "The activity, in Spanish"
    title: String
    "The bodies that process the data"
    organisms: [String]
    "The body responsible for the processing, with its address"
    controller: String
    "The e-mail address of the data protection officer"
    dataProtectionOfficer: String
    "What the data is processed for"
    purpose: String
    "The legal basis, such as an article of the GDPR (RGPD)"
    legalBasis: String
    "The people whose data is processed"
    dataSubjects: String
    "The kinds of personal data processed"
    personalData: String
    "Who receives the data"
    recipients: String
    "Whether the data leaves the European Union"
    internationalTransfers: String
    "How long the data is kept"
    storagePeriod: String
    "How the data is protected"
    securityMeasures: String
    "The ids of the administrative procedures it serves, such as 25947"
    procedures: String
    "The day the record last changed, such as 2026-10-22"
    updated: String
}

"A resolution that refused a request for public information in full or in part"
type JuntaAccessDenial {
    "The id of the resolution"
    id: ID
    "The title, with the number of the request, such as Resolución denegatoria EXP-2026/00002486-PID@"
    title: String
    "What was asked and refused, as HTML"
    description: String
    "The day of the resolution, such as 2026-09-04"
    date: String
    "The reasons for the refusal"
    reasons: [JuntaDenialReason]
    "The resolution, as an anonymized file"
    documents: [JuntaAssignmentDocument]
}

"A reason to refuse a request for public information"
type JuntaDenialReason {
    "The reason, as the transparency law words it, such as Los intereses económicos y comerciales"
    reason: String
    "The outcome: Denegatoria (refused) or Estimatoria parcial (granted in part)"
    outcomes: [String]
}

