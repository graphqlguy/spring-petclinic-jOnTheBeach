"A province of Andalusia, or ANY for all of them"
enum JuntaProvince {
    "Every province"
    ANY
    "Almería"
    ALMERIA
    "Cádiz"
    CADIZ
    "Córdoba"
    CORDOBA
    "Granada"
    GRANADA
    "Huelva"
    HUELVA
    "Jaén"
    JAEN
    "Málaga"
    MALAGA
    "Sevilla"
    SEVILLA
}

"The kind of a public holiday"
enum JuntaHolidayKind {
    "Every kind"
    ANY
    "A holiday of one town"
    LOCAL
    "A national or regional holiday, a non-working day everywhere"
    LABORAL
}
