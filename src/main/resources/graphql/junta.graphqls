# The fields of the open data API of the Junta de Andalucía, the regional government of Andalusia, at
# datos.juntadeandalucia.es/api/v0. The Junta publishes each dataset as an API of its own with an OpenAPI document, and
# all of them work alike: a search, a count, the values each filter takes, and one record by its id. A generator wrote
# these fields and src/main/resources/junta/operations.json from those OpenAPI documents, and their types from answers
# recorded from the service, because the documents leave the answers undescribed. The names and descriptions are written
# by hand in English. Each field is fetched by a RestOperationFetcher, see JuntaConfiguration.

extend type Query {
    # The datasets of the Junta answer in Spanish. A search filter that takes a list of values, such as the themes of a
    # regulation, takes the exact Spanish text that the matching options field lists, such as Sanidad animal. A search
    # without results answers 400 Bad request, and the field returns it as an error saying the Junta rejected the
    # arguments; the description of each search says so.

    """
    The public holidays of Andalusia, its provinces and its municipalities from 2023 on, searched by province, kind,
    municipality and year. LOCAL holidays are the two days each town sets for itself, such as the Málaga fair; LABORAL
    holidays are the national and regional ones. A clinic closes on both. juntaHolidayCalendar gives the whole calendar
    of one town. A search without results answers with the error Bad request.
    """
    juntaHolidays(
        "Only the records of this province of Andalusia. ANY, the default, takes all of them."
        province: JuntaProvince = ANY
        "LOCAL for the holidays of a town, LABORAL for the national and regional ones"
        kind: JuntaHolidayKind = ANY
        "Only the holidays of this municipality, such as Málaga"
        municipality: String
        "Only the holidays of this year, such as 2026"
        year: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaHolidayPage

    "One of the holidays by its id, as a page that holds one record"
    juntaHoliday(
        "The id of the record, which juntaHolidays gives"
        id: ID!
    ): JuntaHolidayPage

    "The number of records of the dataset of holidays of the Junta de Andalucía"
    juntaHolidaysCount: JuntaCount

    "The municipalities with holidays in the dataset, in capitals"
    juntaHolidayMunicipalities: JuntaOptionValues

    "The provinces of the holidays in the dataset"
    juntaHolidayProvinces: JuntaOptionValues

    "The years the dataset covers, with the number of holidays in each"
    juntaHolidayYears: JuntaOptionValues

    """
    The whole calendar of public holidays of one municipality in one year: the national and regional holidays and the
    two local ones, in date order. For example, province MALAGA, municipality MÁLAGA and year 2026.
    """
    juntaHolidayCalendar(
        "The province of the municipality"
        province: JuntaProvince!
        "The municipality, such as Málaga or Torremolinos"
        municipality: String
        "The year, such as 2026"
        year: String
    ): JuntaHolidayCalendar

    "The municipalities of one province that have holidays in the dataset, in capitals, as the calendar takes them"
    juntaHolidayMunicipalitiesOfProvince(
        "The province"
        province: JuntaProvince!
    ): JuntaOptionValues

    """
    The municipalities of Andalusia with their INE codes and positions, searched by name and province. The INE code of
    Málaga is 29067: 29 for the province, 067 for the town. A search without results answers with the error Bad request.
    """
    juntaMunicipalities(
        "Only the municipalities whose name is this, such as Málaga"
        name: String
        "Only the municipalities of this province, by its INE code, such as 29 for Málaga"
        provinceCode: String
        "1 for the capitals of the provinces, 0 for the other municipalities"
        provincialCapital: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaMunicipalityPage

    "The number of records of the dataset of municipalities of the Junta de Andalucía"
    juntaMunicipalitiesCount: JuntaCount

    "The names of the municipalities of Andalusia"
    juntaMunicipalityNames: JuntaOptionValues

    """
    The Tourism Register of Andalusia (RTA): hotels, campsites, rural houses, holiday homes, travel agencies and other
    tourism businesses, searched by kind, category, group, modality, province and municipality. For example, the
    campsites of the municipality of Málaga take objectType Campamento de turismo and municipality MÁLAGA. Names of
    provinces and municipalities are in capitals. A search without results answers with the error Bad request.
    """
    juntaTourismEstablishments(
        """
        Only the establishments of this kind, such as Establecimiento Hotelero, Campamento de turismo, Casa rural or
        Vivienda de uso turístico (holiday home). juntaTourismEstablishmentTypes lists the kinds. Leave it out for all
        of them.
        """
        objectType: String = "-"
        "Only the establishments of this category, such as 4 Estrellas (four stars). Leave it out for all of them."
        category: String = "-"
        "Only the establishments of this group, such as Hotel, Hostal or Camping. Leave it out for all of them."
        group: String = "-"
        """
        Only the establishments of this setting: Playa (beach), Ciudad (city), Rural or Carretera (road). Leave it out
        for all of them.
        """
        modality: String = "-"
        "Only the establishments of this province, such as Málaga. Leave it out for all of them."
        province: String = "-"
        "Only the establishments of this municipality, such as Torremolinos. Leave it out for all of them."
        municipality: String = "-"
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaTourismEstablishmentPage

    "One of the tourism establishments by its id, as a page that holds one record"
    juntaTourismEstablishment(
        "The id of the record, which juntaTourismEstablishments gives"
        id: ID!
    ): JuntaTourismEstablishmentPage

    "The number of records of the dataset of tourism establishments of the Junta de Andalucía"
    juntaTourismEstablishmentsCount: JuntaCount

    "The kinds of tourism establishment, such as Casa rural"
    juntaTourismEstablishmentTypes: JuntaOptionValues

    "The categories of tourism establishments, such as 3 Estrellas"
    juntaTourismCategories: JuntaOptionValues

    "The groups of tourism establishments, such as Hostal"
    juntaTourismGroups: JuntaOptionValues

    "The settings of tourism establishments, such as Playa"
    juntaTourismModalities: JuntaOptionValues

    "The provinces of the tourism establishments"
    juntaTourismProvinces: JuntaOptionValues

    "The municipalities of the tourism establishments"
    juntaTourismMunicipalities: JuntaOptionValues

    """
    The laws, decrees and orders the Junta de Andalucía passed, newest first, searched by theme, subtopic, issuing body,
    kind and title. For the rules about pets, pass subtopic Animales de compañía (companion animals); for animal health,
    Sanidad animal. A search without results answers with the error Bad request.
    """
    juntaRegulations(
        """
        Only the regulations of this theme, such as Ganadería (livestock). juntaRegulationThemes lists them. Leave it
        out for all of them.
        """
        theme: String = "-"
        """
        Only the regulations of this subtopic, such as Animales de compañía. juntaRegulationSubtopics lists them. Leave
        it out for all of them.
        """
        subtopic: String = "-"
        "Only the regulations of this issuing body, such as Servicio Andaluz de Salud. Leave it out for all of them."
        organism: String = "-"
        "Only the regulations of this kind, such as Decreto, Orden or Ley. Leave it out for all of them."
        kind: String = "-"
        "Only the regulations whose title contains these words"
        title: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaRegulationPage

    "One of the regulations by its id, as a page that holds one record"
    juntaRegulation(
        "The id of the record, which juntaRegulations gives"
        id: ID!
    ): JuntaRegulationPage

    "The number of records of the dataset of regulations of the Junta de Andalucía"
    juntaRegulationsCount: JuntaCount

    "The themes of the regulations of the Junta, such as Ganadería"
    juntaRegulationThemes: JuntaOptionValues

    "The subtopics of the regulations, such as Animales de compañía"
    juntaRegulationSubtopics: JuntaOptionValues

    "The bodies of the Junta that issue regulations"
    juntaRegulationOrganisms: JuntaOptionValues

    "The bodies below them"
    juntaRegulationSuborganisms: JuntaOptionValues

    "The kinds of regulation, such as Decreto or Orden"
    juntaRegulationKinds: JuntaOptionValues

    """
    The museums and museum collections of Andalusia, with their addresses, opening hours and positions, searched by
    province, municipality and kind. A search without results answers with the error Bad request.
    """
    juntaMuseums(
        "Only the records of this province of Andalusia. ANY, the default, takes all of them."
        province: JuntaProvince = ANY
        "Only the museums of this municipality, such as Málaga. Leave it out for all of them."
        municipality: String = "-"
        "Only the museums of this kind: Museo, Colección Museográfica or Conjunto. Leave it out for all of them."
        kind: String = "-"
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaMuseumPage

    "One of the museums by its id, as a page that holds one record"
    juntaMuseum(
        "The id of the record, which juntaMuseums gives"
        id: ID!
    ): JuntaMuseumPage

    "The number of records of the dataset of museums of the Junta de Andalucía"
    juntaMuseumsCount: JuntaCount

    "The kinds of museum, such as Colección Museográfica"
    juntaMuseumKinds: JuntaOptionValues

    "The municipalities of Andalusia that have museums"
    juntaMuseumMunicipalities: JuntaOptionValues

    "The provinces of the museums"
    juntaMuseumProvinces: JuntaOptionValues

    """
    The public libraries and documentation centres of Andalusia, with their addresses, contact details and positions,
    searched by province, municipality and kind. A search without results answers with the error Bad request.
    """
    juntaLibraries(
        "Only the records of this province of Andalusia. ANY, the default, takes all of them."
        province: JuntaProvince = ANY
        "Only the libraries of this municipality, such as Torremolinos. Leave it out for all of them."
        municipality: String = "-"
        """
        Only the libraries of this kind: Biblioteca or Bib. Espec./Centro de Documentación. Leave it out for all of
        them.
        """
        kind: String = "-"
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaLibraryPage

    "The number of records of the dataset of libraries of the Junta de Andalucía"
    juntaLibrariesCount: JuntaCount

    "The kinds of library"
    juntaLibraryKinds: JuntaOptionValues

    "The municipalities of Andalusia that have libraries"
    juntaLibraryMunicipalities: JuntaOptionValues

    "The provinces of the libraries"
    juntaLibraryProvinces: JuntaOptionValues

    """
    The public events the Junta de Andalucía organizes or takes part in, such as talks, visits and exhibitions, newest
    first, searched by province, organizer, theme, title and dates. A search without results answers with the error Bad
    request.
    """
    juntaEvents(
        "Only the records of this province of Andalusia. ANY, the default, takes all of them."
        province: JuntaProvince = ANY
        """
        Only the events of this body of the Junta, such as Delegación Territorial en Málaga. Leave it out for all of
        them.
        """
        organism: String = "-"
        "Only the events of this theme, such as Tu salud (your health). Leave it out for all of them."
        theme: String = "-"
        "Only the events whose title contains these words"
        title: String
        "Only the events whose description contains these words"
        description: String
        "Only the events that start on or after this day, such as 2026-10-01"
        startsFrom: String
        "Only the events that start on or before this day, such as 2026-12-31"
        startsTo: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaEventPage

    "One of the events by its id, as a page that holds one record"
    juntaEvent(
        "The id of the record, which juntaEvents gives"
        id: ID!
    ): JuntaEventPage

    "The number of records of the dataset of events of the Junta de Andalucía"
    juntaEventsCount: JuntaCount

    "The themes of the events"
    juntaEventThemes: JuntaOptionValues

    "The provinces of the events"
    juntaEventProvinces: JuntaOptionValues

    "The towns where the events take place"
    juntaEventLocations: JuntaOptionValues

    "What the events cost, as the dataset writes it, such as Actividad gratuita"
    juntaEventCosts: JuntaOptionValues

    """
    The offices of the Junta de Andalucía where people can hand in documents for any public administration, with their
    addresses and opening hours, searched by body, municipality and province. A search without results answers with the
    error Bad request.
    """
    juntaRegistrationOffices(
        """
        Only the offices of this body of the Junta, such as Consejería de Cultura y Deporte. Leave it out for all of
        them.
        """
        body: String = "-"
        "Only the offices of this city, such as Málaga. Leave it out for all of them."
        municipality: String = "-"
        "Only the records of this province of Andalusia. ANY, the default, takes all of them."
        province: JuntaProvince = ANY
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaRegistrationOfficePage

    "One of the registration offices by its id, as a page that holds one record"
    juntaRegistrationOffice(
        "The id of the record, which juntaRegistrationOffices gives"
        id: ID!
    ): JuntaRegistrationOfficePage

    "The number of records of the dataset of registration offices of the Junta de Andalucía"
    juntaRegistrationOfficesCount: JuntaCount

    "The kinds of registration office"
    juntaRegistrationOfficeKinds: JuntaOptionValues

    "The cities with registration offices"
    juntaRegistrationOfficeMunicipalities: JuntaOptionValues

    "The provinces with registration offices"
    juntaRegistrationOfficeProvinces: JuntaOptionValues

    """
    The dispositions of the Boletín Oficial de la Junta de Andalucía (BOJA), the official gazette of Andalusia, newest
    first, searched by section, issuing body, kind, year and number of the bulletin. A search without results answers
    with the error Bad request.
    """
    juntaGazetteDispositions(
        "Only the dispositions of this section, such as 1. Disposiciones generales. Leave it out for all of them."
        section: String = "-"
        "Only the dispositions of this body, such as Consejería de Salud. Leave it out for all of them."
        organisation: String = "-"
        "Only the dispositions of this kind, such as Acuerdo or Resoluciones. Leave it out for all of them."
        kind: String = "-"
        "Only the dispositions of this year, such as 2026"
        year: String
        "Only the dispositions of the bulletin with this number in its year, such as 202"
        number: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaGazetteDispositionPage

    "One of the dispositions of the official gazette by its id, as a page that holds one record"
    juntaGazetteDisposition(
        "The id of the record, which juntaGazetteDispositions gives"
        id: ID!
    ): JuntaGazetteDispositionPage

    "The number of records of the dataset of dispositions of the official gazette of the Junta de Andalucía"
    juntaGazetteDispositionsCount: JuntaCount

    "The sections of the gazette, such as 1. Disposiciones generales"
    juntaGazetteSections: JuntaOptionValues

    "The bodies that publish in the gazette"
    juntaGazetteOrganisations: JuntaOptionValues

    "The kinds of disposition"
    juntaGazetteKinds: JuntaOptionValues

    "The subsections of the gazette"
    juntaGazetteSubsections: JuntaOptionValues

    """
    The consultations in which the Junta de Andalucía asks the public about a law, decree or order it is preparing,
    newest first, searched by body, kind, theme and title. Pass theme Animales de compañía for the ones about pets. A
    search without results answers with the error Bad request.
    """
    juntaPublicConsultations(
        "Only the consultations of this body. Leave it out for all of them."
        organism: String = "-"
        "Only the consultations about this kind of rule: Ley, Decreto or Orden. Leave it out for all of them."
        kind: String = "-"
        "Only the consultations of this theme, such as Animales de compañía. Leave it out for all of them."
        theme: String = "-"
        "Only the consultations whose title contains these words"
        title: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaPublicConsultationPage

    "One of the public consultations by its id, as a page that holds one record"
    juntaPublicConsultation(
        "The id of the record, which juntaPublicConsultations gives"
        id: ID!
    ): JuntaPublicConsultationPage

    "The number of records of the dataset of public consultations of the Junta de Andalucía"
    juntaPublicConsultationsCount: JuntaCount

    "The bodies that hold public consultations"
    juntaPublicConsultationOrganisms: JuntaOptionValues

    "The kinds of rule the consultations are about"
    juntaPublicConsultationKinds: JuntaOptionValues

    "The themes of the consultations, such as Animales de compañía"
    juntaPublicConsultationThemes: JuntaOptionValues

    """
    The statistics, maps and reports the bodies of the Junta de Andalucía publish, newest first, searched by body. A
    search without results answers with the error Bad request.
    """
    juntaStatisticalProducts(
        """
        Only the products of this body, such as Instituto de Estadística y Cartografía de Andalucía. Leave it out for
        all of them.
        """
        organism: String = "-"
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaStatisticalProductPage

    "One of the statistical products by its id, as a page that holds one record"
    juntaStatisticalProduct(
        "The id of the record, which juntaStatisticalProducts gives"
        id: ID!
    ): JuntaStatisticalProductPage

    "The number of records of the dataset of statistical products of the Junta de Andalucía"
    juntaStatisticalProductsCount: JuntaCount

    "The bodies that publish statistical products"
    juntaStatisticalProductOrganisms: JuntaOptionValues

    "The kinds of statistical product"
    juntaStatisticalProductKinds: JuntaOptionValues

    """
    The laws, decrees and orders the Junta de Andalucía is preparing, with their drafts and their status, newest first,
    searched by kind, body, status and title. A search without results answers with the error Bad request.
    """
    juntaDraftRegulations(
        """
        Only the drafts of this kind, such as Proyecto de Decreto del Consejo de Gobierno. Leave it out for all of them.
        """
        kind: String = "-"
        "Only the drafts of this body. Leave it out for all of them."
        organism: String = "-"
        "elaboracion for the drafts in preparation, finalizado for the finished ones. Leave it out for all of them."
        status: String = "-"
        "Only the drafts whose title contains these words"
        title: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaDraftRegulationPage

    "One of the regulations in preparation by its id, as a page that holds one record"
    juntaDraftRegulation(
        "The id of the record, which juntaDraftRegulations gives"
        id: ID!
    ): JuntaDraftRegulationPage

    "The number of records of the dataset of regulations in preparation of the Junta de Andalucía"
    juntaDraftRegulationsCount: JuntaCount

    "The kinds of activity: legislative or regulatory"
    juntaDraftRegulationTypes: JuntaOptionValues

    "The kinds of draft, such as Proyecto de Orden"
    juntaDraftRegulationKinds: JuntaOptionValues

    "The bodies that prepare regulations"
    juntaDraftRegulationOrganisms: JuntaOptionValues

    "The statuses of the drafts"
    juntaDraftRegulationStatuses: JuntaOptionValues

    """
    The books, guides, reports and other publications of the Junta de Andalucía, newest first, searched by year, format,
    body, topic, title, author and subject. The subject Caballos (horses) finds the ones about horses. A search without
    results answers with the error Bad request.
    """
    juntaPublications(
        "Only the publications of this year, such as 2020. Leave it out for all of them."
        year: String = "-"
        "Only the publications in this format: Papel (paper), Electrónico, DVD, CD ROM. Leave it out for all of them."
        format: String = "-"
        "Only the publications of this body. Leave it out for all of them."
        organism: String = "-"
        "Only the publications of this topic, such as Ganadería (livestock). Leave it out for all of them."
        topic: String = "-"
        "Only the publications whose title contains these words"
        title: String
        "Only the publications of this author"
        author: String
        "Only the publications of this subject, in Spanish, such as Caballos or Perros"
        subject: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaPublicationPage

    "One of the publications by its id, as a page that holds one record"
    juntaPublication(
        "The id of the record, which juntaPublications gives"
        id: ID!
    ): JuntaPublicationPage

    "The number of records of the dataset of publications of the Junta de Andalucía"
    juntaPublicationsCount: JuntaCount

    "The years of the publications"
    juntaPublicationYears: JuntaOptionValues

    "The formats of the publications"
    juntaPublicationFormats: JuntaOptionValues

    "The bodies that publish"
    juntaPublicationOrganisms: JuntaOptionValues

    "The topics of the publications"
    juntaPublicationTopics: JuntaOptionValues

    "The subjects of the publications, such as Caballos"
    juntaPublicationSubjects: JuntaOptionValues

    """
    The news of the Junta de Andalucía, newest first, searched by topic, words in the title, subtitle or body, and
    dates. Pass topic Animales de compañía, or Convivencia responsable con animales de compañía, for news about pets. A
    search without results answers with the error Bad request.
    """
    juntaNewsItems(
        """
        Only the news of this topic, such as Animales de compañía. juntaNewsTopics lists them. Leave it out for all of
        them.
        """
        topic: String = "-"
        "Only the news whose title contains these words"
        title: String
        "Only the news whose subtitle contains these words"
        subtitle: String
        "Only the news whose text contains these words"
        body: String
        "Only the news published on or after this day, such as 2026-01-01"
        publishedFrom: String
        "Only the news published on or before this day"
        publishedTo: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaNewsItemPage

    "One of the news by its id, as a page that holds one record"
    juntaNewsItem(
        "The id of the record, which juntaNewsItems gives"
        id: ID!
    ): JuntaNewsItemPage

    "The number of records of the dataset of news of the Junta de Andalucía"
    juntaNewsItemsCount: JuntaCount

    "The topics of the news, such as Animales de compañía"
    juntaNewsTopics: JuntaOptionValues

    """
    The studies and reports of the department of agriculture, livestock, fisheries and rural development of the Junta,
    newest first, by theme, such as Ganadería (livestock) or Agricultura. A search without results answers with the
    error Bad request.
    """
    juntaStudyReports(
        "Only the reports of this theme, such as Ganadería (livestock). Leave it out for all of them."
        theme: String = "-"
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaStudyReportPage

    "One of the studies and reports by its id, as a page that holds one record"
    juntaStudyReport(
        "The id of the record, which juntaStudyReports gives"
        id: ID!
    ): JuntaStudyReportPage

    "The number of records of the dataset of studies and reports of the Junta de Andalucía"
    juntaStudyReportsCount: JuntaCount

    "The bodies that publish studies and reports"
    juntaStudyReportOrganisms: JuntaOptionValues

    "The themes of the studies and reports, such as Ganadería"
    juntaStudyReportThemes: JuntaOptionValues

    """
    The statistical and cartographic activities of the Junta de Andalucía, such as surveys and maps, by kind, department
    and body, with their periodicity. A search without results answers with the error Bad request.
    """
    juntaStatisticalActivities(
        "Only the activities of this kind: Estadística or Cartográfica. Leave it out for all of them."
        kind: String = "-"
        "Only the activities of this department of the Junta. Leave it out for all of them."
        department: String = "-"
        "Only the activities of this body. Leave it out for all of them."
        organism: String = "-"
        "Only the activity with exactly this title, such as Actividades de I+D en Andalucía"
        title: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaStatisticalActivityPage

    "One of the statistical activities by its id, as a page that holds one record"
    juntaStatisticalActivity(
        "The id of the record, which juntaStatisticalActivities gives"
        id: ID!
    ): JuntaStatisticalActivityPage

    "The number of records of the dataset of statistical activities of the Junta de Andalucía"
    juntaStatisticalActivitiesCount: JuntaCount

    "The kinds of activity"
    juntaStatisticalActivityKinds: JuntaOptionValues

    "The departments with statistical activities"
    juntaStatisticalActivityDepartments: JuntaOptionValues

    "The bodies with statistical activities"
    juntaStatisticalActivityOrganisms: JuntaOptionValues

    """
    The conservation and restoration works of the Andalusian Institute of Historical Heritage on monuments, paintings
    and sculptures, by typology. A search without results answers with the error Bad request.
    """
    juntaConservationWorks(
        "Only the works on this typology of heritage, such as Arquitectura Civil. Leave it out for all of them."
        typology: String = "-"
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaConservationWorkPage

    "One of the conservation works on historical heritage by its id, as a page that holds one record"
    juntaConservationWork(
        "The id of the record, which juntaConservationWorks gives"
        id: ID!
    ): JuntaConservationWorkPage

    "The number of records of the dataset of conservation works on historical heritage of the Junta de Andalucía"
    juntaConservationWorksCount: JuntaCount

    "The typologies of heritage"
    juntaConservationWorkTypologies: JuntaOptionValues

    "The provinces of the works"
    juntaConservationWorkProvinces: JuntaOptionValues

    "The municipalities of the works"
    juntaConservationWorkMunicipalities: JuntaOptionValues

    """
    The archives, libraries, museums and other cultural centres of the Junta de Andalucía, with their addresses and
    positions, by province, municipality and kind. A search without results answers with the error Bad request.
    """
    juntaCulturalCentres(
        "Only the centres of this province, such as Málaga. Leave it out for all of them."
        province: String = "-"
        "Only the centres of this municipality, such as Málaga. Leave it out for all of them."
        municipality: String = "-"
        "Only the centres of this kind, such as Archivo or Biblioteca. Leave it out for all of them."
