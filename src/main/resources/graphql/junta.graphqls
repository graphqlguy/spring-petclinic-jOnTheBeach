    "When it was last updated, such as 2025-11-20T15:22:59, in Spanish time"
    updated: String
    "The paths of its pages on www.juntadeandalucia.es"
    paths: [String]
}

"A conservation or restoration work of the Andalusian Institute of Historical Heritage"
type JuntaConservationWork {
    "The id of the work"
    id: ID
    "The title, which names the monument, its town and the work, in Spanish"
    title: String
    "What was restored and how"
    data: [JuntaConservationData]
}

"What a conservation work restored and how"
type JuntaConservationData {
    "The typology of heritage, such as Arquitectura monacal, industrial, carcelaria"
    typology: String
    "When the heritage was made, such as Siglo XIII-XXI"
    chronology: String
    "The size of the work, in words"
    dimensions: String
    "The materials used, in words"
    material: String
    "Who made the heritage, as HTML"
    authorship: String
    "Notes, as HTML"
    observations: String
}

"An archive, library, museum or other cultural centre of the Junta de Andalucía"
type JuntaCulturalCentre {
    "The id of the centre"
    id: ID
    "The name, such as Archivo Histórico Provincial de Málaga"
    name: String
    "The kind of centre, such as Archivo or Biblioteca"
    kind: String
    "The short code of the kind, such as ARCH or BIBL"
    kindCode: String
    "The number of the kind"
    kindId: Int
    "The address, such as Calle Martínez de la Rosa 8, 29009 Málaga"
    address: String
    "The postcode, such as 29009 or 04001"
    postcode: String
    "The town"
    locality: String
    "The municipality"
    municipality: String
    "The INE code of the municipality, such as 29067 for Málaga or 04013 for Almería"
    municipalityIneCode: String
    "The INE code of the town, such as 290670005"
    localityIneCode: String
    "The province"
    province: String
    "The INE code of the province, such as 29 for Málaga"
    provinceCode: Int
    "The latitude"
    latitude: Float
    "The longitude"
    longitude: Float
    "The e-mail address of the centre"
    email: String
    "The web page of the centre"
    web: String
    "The opening hours, in Spanish"
    schedule: String
    "ABI when the centre is open"
    state: String
    "The position of the centre in the directory"
    directoryOrder: Int
    "The address of the record in the catalogue of the Junta"
    resource: String
    "The id of the record in the content system of the Junta"
    catalogueId: String
    "The collection of the record, orbe_localizacion_centros"
    collection: String
    "Whether the record is published"
    available: Boolean
    "When the record last changed"
    modified: DateTime
}

"A directive, instruction, circular or other disposition of a body of the Junta"
type JuntaOtherDisposition {
    "The id of the disposition"
    id: ID
    "The title, in Spanish"
    title: String
    "The topics, such as Programas, proyectos y actividades educativas"
    topics: [String]
    "The bodies that issued it"
    organisms: [JuntaOrganism]
    "The day it was published, such as 2022-06-29"
    published: String
    "published or unpublished"
    state: String
    "The documents of the disposition"
    documents: [JuntaDispositionDocument]
}

"A body of the Junta de Andalucía"
type JuntaOrganism {
    "The name, such as Educación y Deporte"
    name: String
    "The kind of body, such as Consejería (department)"
    kinds: [String]
}

"A document of a disposition"
type JuntaDispositionDocument {
    "The files"
    files: [JuntaFileList]
    "The address of the disposition in the official gazette (BOJA), when it was published there"
    url: String
}

"A document with a title and its files"
type JuntaTitledDocument {
    "The title"
    title: String
    "The files"
    files: [JuntaFileList]
}

"""
A collaboration agreement of the Junta de Andalucía with another administration, a university, a company or an
association. The dataset also names the people who signed, which this schema leaves out.
"""
type JuntaAgreement {
    "The id of the agreement"
    id: ID
    "The title, in Spanish"
    title: String
    "The bodies of the Junta that signed it"
    organisms: [String]
    "The day it was signed, such as 07/05/2024"
    signed: String
    "How long it lasts, in words"
    duration: String
    "What the agreement is for, as HTML"
    objective: String
    "What it costs each party, as HTML"
    economicObligation: String
    "The documents of the agreement"
    documents: [JuntaTitledDocument]
    "When the record last changed"
    updated: DateTime
}

"A plan or programme of the Junta de Andalucía"
type JuntaPlan {
    "The id of the plan"
    id: ID
    "The title, in Spanish"
    title: String
    "What the plan is for, as HTML"
    description: String
    "The day it was approved, when the dataset gives it"
    approved: String
    "The first and last day of the plan, such as 2016-01-01T00:00:00"
    periods: [JuntaDateRange]
    "The departments and bodies in charge of it"
    departments: [JuntaPlanDepartment]
    "The bodies it concerns"
    organisms: [String]
    "The topics, such as Planificación en salud"
    topics: [String]
    "The documents of the plan"
    documents: [JuntaPlanDocument]
    "Links with more information"
    moreInfo: [JuntaLinkList]
}

"A department of the Junta and the body within it that is in charge of a plan"
type JuntaPlanDepartment {
    "The department, such as Servicio Andaluz de Salud"
    department: String
    "The body"
    organism: String
}

"A document of a plan"
type JuntaPlanDocument {
    "The files"
    files: [JuntaMediaList]
}

"The files of a document"
type JuntaMediaList {
    "The files"
    files: [JuntaMediaFile]
}

"A file on www.juntadeandalucia.es"
type JuntaMediaFile {
    "The name of the file"
    name: String
    "The path of the file on www.juntadeandalucia.es"
    path: String
}

"A meeting of the Consejo de Gobierno, the Governing Council of Andalusia"
type JuntaCouncilMeeting {
    "The id of the meeting"
    id: ID
    "The title, such as Sesión del 21/10/2026"
    title: String
    "The agendas of the meeting, as files"
    agendas: [JuntaCouncilAgenda]
    "The matters the council dealt with"
    matters: [JuntaCouncilMatter]
}

"The agenda of a meeting of the Governing Council"
type JuntaCouncilAgenda {
    "The name of the file, such as Orden CG 21-10-26.pdf"
    name: String
    "The paths of the files on www.juntadeandalucia.es"
    paths: [String]
}

"A matter the Governing Council dealt with in a meeting"
type JuntaCouncilMatter {
    "The title, in Spanish"
    title: String
    "The subtitle"
    subtitle: String
    "The summary, as HTML"
    summary: String
    "The day of the meeting, such as 2026-10-21"
    date: String
}

"A document of the Junta de Andalucía open to the comments of the public"
type JuntaPublicDocument {
    "The id of the document"
    id: ID
    "The title, in Spanish"
    title: String
    "The kind of document and what it starts, in Spanish"
    kind: String
    "The bodies that publish it"
    organisms: [String]
    "The themes, such as Minas"
    themes: [String]
    "The day it was published, such as 22/10/2026"
    published: String
    "When the public can send comments"
    commentPeriods: [JuntaCommentPeriod]
    "The documents"
    documents: [JuntaTitledDocument]
    "When the record last changed"
    updated: DateTime
}

"When the public can send comments on a document"
type JuntaCommentPeriod {
    "The first day, such as 22/10/2026"
    start: String
    "The last day"
    end: String
    "The term, in words"
    term: String
}

"""
A state training course for employment in Andalusia. The dataset also lists the e-mail address, phone number and contact
person of each course, which this schema leaves out.
"""
type JuntaTrainingCourse {
    "The id of the course"
    id: ID
    "The code and title, such as AFDP02 Protocolo de evaluación y primeros auxilios en autobuses"
    title: String
    "The editions of the course, with their dates"
    sessions: [JuntaCourseSession]
}

"An edition of a training course"
type JuntaCourseSession {
    "Teleformación (online), Mixta or Presencial (in a classroom)"
    modality: String
    "The first day, such as 2026-10-22"
    start: String
    "The last day"
    end: String
    "The last day to register"
    registrationDeadline: String
    "The length of the course, in hours"
    hours: Int
    "The place of a course in a classroom, such as HUELVA"
    location: String
    "Where to register, when the dataset gives it"
    registrationAddress: String
}

"A job offer of a public company or agency of the Junta de Andalucía"
type JuntaJobOffer {
    "The id of the offer"
    id: ID
    "The job, such as INSPECTOR/A DE ITV"
    jobName: String
    "The code of the offer, such as P0053_0027"
    code: String
    "The kind of offer, such as Oferta de empleo"
    kind: String
    "En curso while it is open, Concluido when it closed"
    status: String
    "The kind of contract, such as Duración determinada- prácticas"
    contract: String
    "The number of places"
    places: Int
    "The level of degree it asks for"
    officialDegree: String
    "The degree it asks for"
    specificDegree: String
    "What the job does, as HTML"
    functions: String
    "The other requirements, as HTML"
    otherRequirements: String
    "The day it was published, such as 2026-10-20"
    published: String
    "The last day to apply"
    deadline: String
    "The internal names of the bodies that offer it, such as haciendaindustriayenergia_adscritos_veiasa"
    organisms: [String]
    "Where the jobs are"
    locations: [JuntaJobLocation]
}

"Where the jobs of an offer are"
type JuntaJobLocation {
    "The town, sometimes with the number of places, such as Vícar (1)"
    locality: String
    "The provinces, such as Almería"
    provinces: [String]
}

"An organic unit of a Spanish administration in DIR3, the common directory of the administrations"
type JuntaOrganicUnit {
    "The DIR3 code of the unit, such as A15034172"
    id: ID
    "The name of the unit"
    name: String
    "The tax id (NIF) of the unit"
    taxId: String
    "The level of administration, such as Administración Autonómica"
    level: String
    "The number of the level of administration"
    levelId: Int
    "How deep the unit sits below the top unit"
    hierarchicalLevel: Int
    "The kind of public entity, such as ORGANISMO AUTONOMO"
    entityType: String
    "The code of the kind of public entity, such as OA"
    entityTypeCode: String
    "The DIR3 code of the unit right above it"
    topUnitId: String
    "The name of the unit right above it"
    topUnitName: String
    "The DIR3 code of the administration it belongs to"
    mainUnitId: String
    "The name of the administration it belongs to, such as Comunidad Foral de Navarra"
    mainUnitName: String
    "Whether it is an entity of public law"
    publicLawEntity: Boolean
    "The DIR3 code of its entity of public law"
    publicLawEntityId: String
    "The name of its entity of public law"
    publicLawEntityName: String
    "Vigente while the unit exists"
    state: String
    "V while the unit exists"
    stateCode: String
    "When the unit was created, such as 2015-10-23T00:00:00"
    released: String
    "The day the record was approved, followed by the code of the unit, such as 20230124A15034172"
    approval: String
}

"A building or plot of land the Junta de Andalucía owns"
type JuntaProperty {
    "The id of the property, such as 00024"
