}

"The files of a valuation table"
type JuntaRatingFile {
    "The files"
    files: [JuntaFileList]
}

"Where the official gazette published something"
type JuntaGazetteExcerptList {
    "The issues of the gazette"
    excerpts: [JuntaGazetteExcerpt]
}

"An issue of the official gazette of Andalusia (BOJA)"
type JuntaGazetteExcerpt {
    "The number and day of the issue, such as Nº 128, 07/07/03"
    issue: String
    "The address of the page in the gazette"
    url: String
}

"""
A local entity of Andalusia in the Andalusian Register of Local Entities (RAEL): a municipality, a province, an
association of municipalities, a consortium or a decentralized entity. The register also names the president of each
entity and gives an e-mail address, which this schema leaves out.
"""
type JuntaLocalEntity {
    "The id of the entity"
    id: ID
    "The name, such as MANCOMUNIDAD DE MUNICIPIOS DE LA COSTA DEL SOL OCCIDENTAL"
    name: String
    "The kind of entity, such as MUNICIPIO or MANCOMUNIDAD"
    kind: String
    "The typology, such as ENTIDAD LOCAL AUTÓNOMA, when it has one"
    typology: String
    "The population, written as 1.255"
    population: String
    "The length of its boundary, in kilometres"
    boundaryKm: Float
    "The class of its secretariat, such as PRIMERA"
    secretariat: String
    "Its legal regime, such as REGIMEN COMÚN"
    regime: String
    "The issue of the official gazette (BOJA) that published it"
    gazetteIssue: String
    "The day of that issue, such as 31/05/2023"
    gazetteDate: String
    "Where its seat is"
    capital: JuntaLocalCapital
    "What the entity is for"
    powers: JuntaLocalPowers
    "Its latest budget"
    budget: JuntaLocalBudget
    "The municipalities in an association of municipalities"
    municipalities: [JuntaLocalEntityRef]
    "The consortia it belongs to"
    consortia: [JuntaLocalEntityRef]
    "The associations of municipalities it belongs to"
    associations: [JuntaLocalEntityRef]
    "The other bodies it belongs to, such as FEDERACIÓN ESPAÑOLA DE MUNICIPIOS Y PROVINCIAS"
    otherMemberships: [JuntaLocalMembership]
    "The companies and bodies that depend on it"
    linkedBodies: [JuntaLocalLinkedBody]
    "The towns and villages of a municipality"
    settlements: [String]
    "The decentralized entities of a municipality"
    decentralized: [JuntaLocalEntityRef]
    "The municipalities that border a municipality"
    neighbours: [JuntaNeighbourMunicipality]
    "The flag and coat of arms"
    symbols: [JuntaLocalSymbol]
    "The political groups that govern it"
    governingGroups: [JuntaGoverningGroup]
    "The political groups in its council, with their seats"
    councilGroups: [JuntaCouncilGroup]
    "The office of its president"
    president: JuntaLocalPresident
    "The address of its seat"
    address: JuntaLocalAddress
    "The phone number of its seat"
    phone: String
    "The fax number of its seat"
    fax: String
    "Its web site"
    web: String
}

"Where the seat of a local entity is"
type JuntaLocalCapital {
    "The municipality, such as MARBELLA"
    municipality: String
    "The town or village within it"
    settlement: String
    "The province, written as PROVINCIA MÁLAGA"
    province: String
    "The issue of the official gazette (BOJA) that set it"
    gazetteIssue: String
    "The day of that issue"
    gazetteDate: String
}

"What a local entity is for"
type JuntaLocalPowers {
    "Its purposes and powers, in capitals, in Spanish"
    text: String
    "The issue of the official gazette (BOJA) that published them"
    gazetteIssue: String
    "The day of that issue"
    gazetteDate: String
}

"The budget of a local entity for one year"
type JuntaLocalBudget {
    "The year, such as 2022"
    year: String
    "The income, in euros, written as 14.925.217,81"
    income: String
    "The spending, in euros, written the same way"
    spending: String
}

"A local entity named by another"
type JuntaLocalEntityRef {
    "The code of the entity in the register, such as JA0504006"
    code: String
    "The name"
    name: String
}

"A body a local entity belongs to"
type JuntaLocalMembership {
    "The tax id of the body, such as G28783991"
    code: String
    "PÚBLICA or PRIVADA"
    kind: String
    "The name"
    name: String
}

"A company or body that depends on a local entity"
type JuntaLocalLinkedBody {
    "The name and tax id, such as ACOSOL, S.A.(A29658416)"
    name: String
    "The address"
    address: String
    "The kind, such as SOCIEDAD MERCANTIL LOCAL"
    kind: String
    "The public service it provides, such as Ciclo integral del agua de uso urbano"
    service: String
}

"A municipality that borders another"
type JuntaNeighbourMunicipality {
    "The name, in capitals"
    name: String
    "The province, in capitals"
    province: String
}

"The flag or coat of arms of a local entity"
type JuntaLocalSymbol {
    "BANDERA (flag) or ESCUDO (coat of arms)"
    kind: String
    "The heraldic description, in Spanish"
    description: String
    "The address of the image"
    imageUrl: String
}

"A political group that governs a local entity"
type JuntaGoverningGroup {
    "The name of the party"
    name: String
    "The day it was elected, such as 17/06/2023"
    elected: String
}

"A political group in the council of a local entity"
type JuntaCouncilGroup {
    "The name of the party"
    name: String
    "The number of its members"
    members: Int
    "The number of members who left the group"
    nonAttached: Int
}

"The office of the president of a local entity"
type JuntaLocalPresident {
    "The office, such as PRESIDENTE/A or ALCALDE/SA (mayor)"
    office: String
    "The party of the president"
    party: String
    "The day the president was appointed, such as 26/07/2019"
    appointed: String
}

"The address of the seat of a local entity"
type JuntaLocalAddress {
    "The kind of street, such as AVENIDA"
    streetType: String
    "The street"
    street: String
    "The number"
    number: String
    "The postcode"
    postcode: String
    "The municipality"
    municipality: String
}

"A report of the Advisory Commission on Administrative Contracting"
type JuntaCommissionReport {
    "The id of the report"
    id: ID
    "The title, which gives its number, day and question"
    title: String
    "The title of its file, when it has one"
    fileTitle: String
    "The day it was published, such as 2026-07-23"
    published: String
    "published once it is public"
    state: String
}

"What a body of the Junta spent on institutional advertising in one period"
type JuntaAdvertisingExpense {
    "The id of the record"
    id: ID
    "The body and period, such as Instituto Andaluz de Prevención de Riesgos Laborales. Segundo trimestre 2026"
    title: String
    "The periods of the spending"
    periods: [JuntaAdvertisingPeriod]
    "The contracts with media and agencies"
    contracts: [JuntaAdvertisingContract]
    "The grants for advertising"
    grants: [JuntaAdvertisingGrant]
    "Where the official gazette published it"
    publication: JuntaDocumentLink
}

"A four-month period of spending"
type JuntaAdvertisingPeriod {
    "Primer cuatrimestre, Segundo cuatrimestre or Tercer cuatrimestre"
    period: String
    "The year"
    year: String
}

"A contract for institutional advertising"
type JuntaAdvertisingContract {
    "The contract, such as an extension of a lot of conventional media"
