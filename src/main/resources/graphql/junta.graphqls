        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaTransparencyUnitPage

    "One of the transparency units by its id, as a page that holds one record"
    juntaTransparencyUnit(
        "The id of the record, which juntaTransparencyUnits gives"
        id: ID!
    ): JuntaTransparencyUnitPage

    "The number of records of the dataset of transparency units of the Junta de Andalucía"
    juntaTransparencyUnitsCount: JuntaCount

    "The bodies the units serve"
    juntaTransparencyUnitScopes: JuntaOptionValues

    "The names of the units"
    juntaTransparencyUnitTitles: JuntaOptionValues

    """
    The inventory of the activities in which the bodies of the Junta de Andalucía process personal data, with their
    purpose, legal basis, the kinds of data and people concerned, and how long the data is kept, by body. A search
    without results answers with the error Bad request.
    """
    juntaDataProcessingActivities(
        "Only the activities of this body, such as Agencia Andaluza de la Energía. Leave it out for all of them."
        organism: String = "-"
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaDataProcessingActivityPage

    "One of the activities that process personal data by its id, as a page that holds one record"
    juntaDataProcessingActivity(
        "The id of the record, which juntaDataProcessingActivities gives"
        id: ID!
    ): JuntaDataProcessingActivityPage

    "The number of records of the dataset of activities that process personal data of the Junta de Andalucía"
    juntaDataProcessingActivitiesCount: JuntaCount

    "The bodies with activities that process personal data"
    juntaDataProcessingActivityOrganisms: JuntaOptionValues

    """
    The resolutions by which a body of the Junta de Andalucía refused a request for public information in full or in
    part, newest first, by body and outcome, with the reason. The resolutions are published anonymized. A search without
    results answers with the error Bad request.
    """
    juntaAccessDenials(
        """
        Only the resolutions of this body, such as Agricultura, Ganadería, Pesca y Desarrollo Sostenible. Leave it out
        for all of them.
        """
        organism: String = "-"
        """
        Only the resolutions with this outcome: Denegatoria (refused) or Estimatoria parcial (granted in part). Leave it
        out for all of them.
        """
        outcome: String = "-"
        "Only the resolutions of this day, such as 2026-10-13"
        date: String
        "The number of results to return, from 1 to 100"
        size: Int! = 10
    ): JuntaAccessDenialPage

    "One of the refusals of requests for public information by its id, as a page that holds one record"
    juntaAccessDenial(
        "The id of the record, which juntaAccessDenials gives"
        id: ID!
    ): JuntaAccessDenialPage

    "The number of records of the dataset of refusals of requests for public information of the Junta de Andalucía"
    juntaAccessDenialsCount: JuntaCount

    "The bodies with resolutions"
    juntaAccessDenialOrganisms: JuntaOptionValues

    "The outcomes of the resolutions"
    juntaAccessDenialOutcomes: JuntaOptionValues
}

"The number of records of a dataset"
type JuntaCount {
    "The number of records"
    total: Int
}

"The values a filter of a dataset takes"
type JuntaOptionValues {
    "The values, in Spanish, as the filter takes them"
    values: [String]
    "How many records have each value, when the dataset counts them"
    counts: [JuntaValueCount]
}

"How many records of a dataset have one value"
type JuntaValueCount {
    "The value"
    value: String
    "The number of records with the value"
    count: Int
}

"A point on the map in the coordinates of Spanish maps"
type JuntaUtmPoint {
    """
    The easting in metres, in UTM zone 30N (ETRS89, EPSG:25830), the grid of Spanish maps. Divide by 1000 for
    kilometres; it is not a latitude or longitude.
    """
    x: Float
    """
    The northing in metres, in UTM zone 30N (ETRS89, EPSG:25830), the grid of Spanish maps. Divide by 1000 for
    kilometres; it is not a latitude or longitude.
    """
    y: Float
}

"The first and last day of something, as the dataset writes them"
type JuntaDateRange {
    "The first day, written as 2026-11-04 or as 01/09/2017"
    start: String
    "The last day, written the same way"
    end: String
}

"The public holidays of one municipality in one year"
type JuntaHolidayCalendar {
