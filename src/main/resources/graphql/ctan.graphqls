        """
        consortiumId: Int! = 4
        "The latitude of the point, such as 36.7213 in the centre of Málaga"
        latitude: Float!
        "The longitude of the point, such as -4.4214"
        longitude: Float!
    ): CtanStopList

    "One stop by its id, with its town and the lines that call there"
    ctanStop(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the stop, such as 149 for Terminal Muelle Heredia in Málaga"
        stopId: ID!
    ): CtanStop

    """
    The departures from a stop in the quarter of an hour after a time, with the line and its destination. Leave from out
    for the departures from now.
    """
    ctanDepartures(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the stop, such as 149 for Terminal Muelle Heredia in Málaga"
        stopId: ID!
        "The day and time to start from, written as 23-10-2026 10:00"
        from: String
    ): CtanDepartureList

    """
    The fare zones of a consortium, such as A for the city of Málaga. The fare of a trip depends on how many zone
    boundaries it crosses, the jumps.
    """
    ctanZones(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
    ): CtanZoneList

    "The stops of one fare zone"
    ctanStopsInZone(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the zone, such as A"
        zoneId: ID!
    ): CtanStopList

    "How many zone boundaries a trip crosses from each fare zone to each other one, the jumps that set the fare"
    ctanZoneJumps(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
    ): CtanZoneJumpList

    "How many zone boundaries a trip from one town to another crosses, which sets its fare in ctanInterurbanFares"
    ctanJumpsBetweenTowns(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
