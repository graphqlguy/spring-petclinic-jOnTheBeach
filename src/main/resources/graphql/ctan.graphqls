# The fields of the Network of Transport Consortia of Andalusia (CTAN), at api.ctan.es. Each consortium runs the buses,
# trains and metro lines between the towns of one area, and the Málaga area is consortium 4. A generator wrote these
# fields, their types and src/main/resources/ctan/operations.json from the apiDoc documentation of the service and from
# answers recorded from it. The names and descriptions are written by hand in English. The documentation lists more
# operations; the ones that answered 404 or an error on 22 October 2026 are left out. Each field is fetched by a
# RestOperationFetcher, see CtanConfiguration.

extend type Query {
    # The consortia publish the lines, stops, timetables, fares and zones of the public transport between towns. A town
    # (núcleo) is a place with stops, and a municipality can hold several towns: the municipality of Málaga holds the
    # city, the airport and Teatinos, among others. Every id is written as text.

    """
    The transport consortia of Andalusia, such as Área de Málaga (4) or Área de Sevilla (1), with their ids for the
    consortiumId argument of the other fields
    """
    ctanConsortia: CtanConsortiumList

    "The municipalities a consortium serves, such as Málaga, Torremolinos or Fuengirola"
    ctanMunicipalities(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
    ): CtanMunicipalityList

    "One municipality of a consortium, by its id"
    ctanMunicipality(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the municipality, such as 1 for Málaga. ctanMunicipalities lists them."
        municipalityId: ID!
    ): CtanMunicipality

    "The towns (núcleos) of one municipality, such as the airport and Teatinos in Málaga"
    ctanTownsInMunicipality(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the municipality, such as 1 for Málaga. ctanMunicipalities lists them."
        municipalityId: ID!
    ): CtanTownList

    """
    Every town (núcleo) a consortium serves, with its municipality and fare zone. A question about buses from one place
    to another starts here, to find the ids of the towns.
    """
    ctanTowns(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
    ): CtanTownList

    "One town (núcleo) by its id"
    ctanTown(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the town (núcleo), such as 1 for Málaga or 107 for Torremolinos. ctanTowns lists them."
        townId: ID!
    ): CtanTown

    "The lines that stop in a town (núcleo)"
    ctanLinesInTown(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the town (núcleo), such as 1 for Málaga or 107 for Torremolinos. ctanTowns lists them."
        townId: ID!
    ): CtanLineList

    "The stops of a town (núcleo), with their names and fare zones"
    ctanStopsInTown(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the town (núcleo), such as 1 for Málaga or 107 for Torremolinos. ctanTowns lists them."
        townId: ID!
    ): CtanStopList

    "The lines that stop in one town of one municipality, with their transport mode"
    ctanLinesInMunicipalityTown(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the municipality, such as 1 for Málaga. ctanMunicipalities lists them."
        municipalityId: ID!
        "The id of the town (núcleo), such as 1 for Málaga or 107 for Torremolinos. ctanTowns lists them."
        townId: ID!
    ): CtanMunicipalityLineList

    "The stops of one town of one municipality"
    ctanStopsInMunicipalityTown(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The id of the municipality, such as 1 for Málaga. ctanMunicipalities lists them."
        municipalityId: ID!
        "The id of the town (núcleo), such as 1 for Málaga or 107 for Torremolinos. ctanTowns lists them."
        townId: ID!
    ): CtanStopList

    """
    The lines of a consortium: buses, trains and metro. With latitude and longitude, only the lines that stop near that
    point, so the lines near an owner's home take the point of the address.
    """
    ctanLines(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
