    "How many columns of blocks the town spans"
    columns: Int
    "The background colour of the town in the timetable, as #RRGGBB"
    color: String
}

"A block of stops, one column of a timetable"
type CtanTimetableBlock {
    "The name of the block of stops, such as Estación de Muelle Heredia"
    name: String
    "The colour of the fare zone of the block, as #RRGGBB"
    color: String
    "The kind of column: 1 for the column of line codes, 0 for a block of stops"
    type: String
}

"One departure of a timetable, with its time at each block of stops"
type CtanTimetableRow {
    """
    The time of the departure at each block of stops, in the order of the blocks, such as 06:20. -- means the departure
    does not stop at that block.
    """
    times: [String]
    "The days the departure runs, as an abbreviation of frequencies, such as L-V for Monday to Friday"
    days: String
    "Notes about the departure, in Spanish, or an empty text"
    notes: String
    "A code some departures carry, such as 1,76434_3, or an empty text. The documentation of the service leaves it out."
    onDemand: String
    "The id of the line of the departure, in the timetables of several lines"
    lineId: ID
    "The code of the line of the departure, such as M-110"
    lineCode: String
}

"An abbreviation of the days a departure runs"
type CtanFrequencyCode {
    "The id of the frequency"
    id: ID
    "The abbreviation, such as L-V"
    abbreviation: String
    "What the abbreviation means, such as Monday to friday working days"
    name: String
}

"The departures of every line between two towns"
type CtanTripTimetable {
    "The columns of the timetable"
    blocks: [CtanTimetableBlock]
    "The departures, one row each, with the line of each"
    trips: [CtanTimetableRow]
    "The abbreviations of days that the timetable uses"
    frequencies: [CtanFrequencyCode]
    "The towns above the columns"
    towns: [CtanTimetableTown]
    "Notes about each mode of transport"
    modeNotes: [CtanModeNote]
}

"A note about one mode of transport in a timetable"
type CtanModeNote {
    "The mode of transport, such as BUS"
    mode: String
    "The note, such as how exact the times of passing are"
    notes: String
}

"The timetable of the lines of a corridor"
type CtanCorridorTimetable {
    "The towns of the outbound timetable"
    outboundTowns: [CtanTimetableTown]
    "The columns of the outbound timetable"
    outboundBlocks: [CtanTimetableBlock]
    "The outbound departures, with the line of each"
    outboundTrips: [CtanTimetableRow]
    "The towns of the return timetable"
    returnTowns: [CtanTimetableTown]
    "The columns of the return timetable"
    returnBlocks: [CtanTimetableBlock]
    "The return departures, with the line of each"
    returnTrips: [CtanTimetableRow]
    "The abbreviations of days that the timetable uses"
    frequencies: [CtanFrequencyCode]
    "Notes about each mode of transport"
    modeNotes: [CtanModeNote]
}

"The departures from a stop in a quarter of an hour"
type CtanDepartureList {
    "The departures, in time order"
    departures: [CtanDeparture]
    "The start of the quarter of an hour, such as 2026-10-23 10:00"
    from: String
    "The end of the quarter of an hour, such as 2026-10-23 10:15"
    to: String
}

"A departure of a line from a stop"
type CtanDeparture {
    "The id of the stop"
    stopId: ID
    "The id of the line"
    lineId: ID
    "The time the line passes the stop, such as 10:00"
    time: String
    "The code of the line, such as M-110"
    lineCode: String
    "The name of the line"
    lineName: String
    "The direction: 1 outbound, 2 for the return"
    direction: Int
    "Where the line goes, such as Flatotel"
    destination: String
    "Who may use the stop: 0 to get on and off, 1 to get on only, 2 to get off only"
    stopType: Int
}

"The fare zones of a consortium"
type CtanZoneList {
    "The zones"
    zones: [CtanZone]
}

"A fare zone"
type CtanZone {
    "The id of the zone, such as A"
    id: ID
    "The name of the zone, such as Zone A"
    name: String
    "The colour of the zone on maps and timetables, as #RRGGBB"
    color: String
}

"The jumps between the fare zones"
type CtanZoneJumpList {
    "One entry for each pair of zones"
    jumps: [CtanZoneJump]
}

"How many zone boundaries a trip from one zone to another crosses"
type CtanZoneJump {
    "The zone the trip starts in, or -- for the header of the table"
    fromZone: String
    "The zone the trip ends in, or -- for the header of the table"
    toZone: String
    "The number of jumps, or -1 for the header of the table"
    jumps: Int
}

"The jumps of a trip between two towns"
type CtanJumpCalculation {
    "The number of jumps, or an error"
    result: CtanJumps
}

"The number of zone boundaries a trip crosses"
type CtanJumps {
    "The number of jumps, or -1 when the service could not tell"
    jumps: Int
    "Why the service could not tell, or an empty text"
    error: String
}

"The fares between towns"
type CtanInterurbanFareList {
    "One fare for each number of jumps"
    fares: [CtanInterurbanFare]
}

"The fare of a trip between towns, by the number of zone boundaries it crosses"
type CtanInterurbanFare {
    "The number of jumps, from 0 for a trip within one zone"
    jumps: Int
    "The price of a single ticket, in euros"
    singleTicket: Float
    "The price with the consortium's card, in euros"
    card: Float
}

"The fares of the city buses"
type CtanUrbanFareList {
    "One fare for each town"
    fares: [CtanUrbanFare]
}

"The fare of the city buses of a town"
type CtanUrbanFare {
    "The town, such as Alhaurín de la Torre"
    town: String
    "The price with a change from an interurban line, in euros"
    withChange: Float
    "The price without a change, in euros"
    withoutChange: Float
}

"The modes of transport of a consortium"
type CtanTransportModeList {
    "The modes"
    modes: [CtanTransportMode]
}

"A mode of transport, such as Bus or Train"
type CtanTransportMode {
    "The id of the mode, for the modeId arguments"
    id: ID
    "The name of the mode, such as Bus, Train, Subway or Bicycle"
    name: String
    "Notes about the mode, or an empty text"
    notes: String
    "Whether the mode is a bus"
    bus: Boolean
    "Whether the mode is a boat"
    boat: Boolean
    "Whether the mode is a train"
    train: Boolean
    "Whether the mode is a tram"
    tram: Boolean
    "Whether the mode is a metro"
    metro: Boolean
    "Whether the mode is a bicycle"
    bicycle: Boolean
}

"The kinds of day of the timetables"
type CtanFrequencyList {
    "The kinds of day"
    frequencies: [CtanFrequency]
}

"A kind of day a timetable distinguishes"
type CtanFrequency {
    "The id of the kind of day, for the frequencyId argument of ctanLineTimetable"
    id: ID
    "The abbreviation, such as L-V for lunes a viernes, Monday to Friday"
    code: String
    "The kind of day, in Spanish, such as Lunes a viernes"
    name: String
}

"The abbreviations of days of the timetables"
type CtanAbbreviationList {
    "The abbreviations"
    abbreviations: [CtanFrequencyCode]
}

"The kinds of point of interest"
type CtanPointOfInterestCategoryList {
    "The kinds"
    categories: [CtanPointOfInterestCategory]
}

"A kind of point of interest"
type CtanPointOfInterestCategory {
    "The id of the kind, for the categoryId argument"
    id: ID
    "The name of the kind, such as Bicycle Parking, or null when the service names it in Spanish alone"
    name: String
}

"Points of interest of a consortium"
type CtanPointOfInterestList {
    "The places"
    places: [CtanPointOfInterest]
}

"A point of interest near the public transport, such as a bicycle parking"
type CtanPointOfInterest {
    "The id of the place"
    id: ID
    "The name of the place, or null"
    name: String
    "The id of the kind of place"
    categoryId: ID
    "The kind of place, or null"
    category: String
    "The id of the municipality of the place"
    municipalityId: ID
    "The name of the municipality, such as Málaga"
    municipality: String
    "The latitude of the place, or null"
    latitude: Float
    "The longitude of the place, or null"
    longitude: Float
}

"The places that sell the consortium's card"
type CtanSalesPointList {
    "The places"
    places: [CtanSalesPoint]
}

"A place that sells and tops up the consortium's card"
type CtanSalesPoint {
    "The id of the place"
    id: ID
    "The id of the kind of place"
    typeId: ID
    "The kind of place, such as Tobacconist"
    type: String
    "The address, in Spanish"
    address: String
    "The id of the town (núcleo)"
    townId: ID
    "The name of the town, such as Algarrobo Costa"
    town: String
    "The id of the municipality"
    municipalityId: ID
    "The name of the municipality"
    municipality: String
    "The latitude of the place"
    latitude: Float
    "The longitude of the place"
    longitude: Float
}

"The categories of the news"
type CtanNewsCategoryList {
    "The categories"
    categories: [CtanNewsCategory]
}

"A category of news"
type CtanNewsCategory {
    "The id of the category"
    id: ID
    "The name, in Spanish, such as NUEVOS HORARIOS O TRAYECTOS (new timetables or routes)"
    name: String
}

"News of a consortium"
type CtanNewsList {
    "The news items"
    news: [CtanNewsItem]
}

"A news item of a consortium, such as a new timetable or a closed road"
type CtanNewsItem {
    "The id of the news item, for ctanNewsItem"
    id: ID
    "The id of the category of the news item"
    categoryId: ID
    "The category of the news item, in Spanish, such as GENERAL CONSORCIO"
    category: String
    "The title, in Spanish"
    title: String
    "The subtitle, in Spanish"
    subtitle: String
    "A summary, in Spanish"
    summary: String
    "The first day the news applies, such as 2026-10-06, sometimes followed by a time"
    starts: String
    "The last day the news applies, such as 2026-12-31, sometimes followed by a time"
    ends: String
    "The last day the news is shown, such as 2026-12-31"
    fixedEnd: String
    "Whether the news item is marked as new"
    isNew: Boolean
    "The line the news item is about, in the fields for one line"
    lineId: ID
    "The ids of the lines the news item is about, separated by commas"
    lineIds: String
    "The full text, in Spanish, as HTML. ctanNewsItem fills it in."
    text: String
    "The place of the news item in the list"
    order: Int
}

"The corridors of a consortium"
type CtanCorridorList {
    "The corridors"
    corridors: [CtanCorridor]
}

"A corridor: lines that share a timetable along one route"
