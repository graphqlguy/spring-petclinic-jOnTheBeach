    "The towns of the return timetable"
    returnTowns: [CtanTimetableTown]
    "The blocks of stops of the return timetable"
    returnBlocks: [CtanTimetableBlock]
    "The return departures, one row each"
    returnTrips: [CtanTimetableRow]
}

"A town (núcleo) at the head of the columns of a timetable"
type CtanTimetableTown {
    "The name of the town, or an empty text above the column of line codes"
