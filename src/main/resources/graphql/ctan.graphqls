        """
        consortiumId: Int! = 4
        "The town the trip starts from, such as 1 for Málaga"
        fromTownId: ID!
        "The town the trip ends in, such as 111 for Fuengirola"
        toTownId: ID!
    ): CtanJumpCalculation

    "The fares between towns, by the number of jumps: a single ticket, and the fare with the consortium's card"
    ctanInterurbanFares(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
