    ): CtanLineTimetable

    """
    The departures of every line from one town (núcleo) to another, such as from Málaga to Torremolinos. The two towns
    must differ.
    """
    ctanTimetableBetweenTowns(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
        for the Bay of Cádiz.
        """
        consortiumId: Int! = 4
        "The town the trip starts from, such as 1 for Málaga"
        fromTownId: ID!
        "The town the trip ends in, such as 107 for Torremolinos"
        toTownId: ID!
    ): CtanTripTimetable

    "The stops of a consortium near a point, nearest first, with their towns and positions"
    ctanStopsNear(
        """
        The consortium: 4 for the Málaga area, the default. ctanConsortia lists the others, such as 1 for Seville or 2
