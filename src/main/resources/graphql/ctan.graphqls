"The transport consortia of Andalusia"
type CtanConsortiumList {
    "The consortia"
    consortia: [CtanConsortium]
}

"A transport consortium, which runs the public transport between the towns of one area"
type CtanConsortium {
    "The id of the consortium, for the consortiumId arguments: 4 for the Málaga area"
    id: ID
    "The name of the area, such as Área de Málaga"
    name: String
    "The initials of the consortium, such as CTMAM for the Málaga area"
    shortName: String
}

"The municipalities a consortium serves"
type CtanMunicipalityList {
    "The municipalities"
    municipalities: [CtanMunicipality]
}

"A municipality a consortium serves"
type CtanMunicipality {
    "The id of the municipality in the consortium, for the municipalityId arguments, such as 1 for Málaga"
    id: ID
    "The name of the municipality, such as Torremolinos"
    name: String
}

"Towns (núcleos) of a consortium"
type CtanTownList {
    "The towns"
    towns: [CtanTown]
}

"A town (núcleo): a place with stops, such as a city, a village or an airport"
type CtanTown {
    "The id of the town, for the townId arguments, such as 1 for Málaga"
    id: ID
    "The name of the town, such as Torremolinos or Aeropuerto de Málaga"
    name: String
    "The id of the municipality the town belongs to"
    municipalityId: ID
    "The fare zone of the town, such as A for the city of Málaga"
    zoneId: ID
}

"Lines of a consortium"
type CtanLineList {
    "The lines"
    lines: [CtanLine]
}

"The lines of one town of one municipality"
type CtanMunicipalityLineList {
    "The lines, under a key the service names lugaresInteres"
    lines: [CtanLine]
}

"A line of buses, trains or metro"
type CtanLine {
    "The id of the line, for the lineId arguments"
    id: ID
    "The code of the line, such as M-110 for a bus or C-1 for a commuter train"
    code: String
    "The name of the line, which says where it runs, such as Málaga-Torremolinos-Benalmádena Costa"
    name: String
    "The mode of transport, in Spanish, such as Autobús, Tren or Metro"
    mode: String
    "The id of the mode of transport, such as 1 for buses and 2 for trains in Málaga"
    modeId: ID
    "The companies that run the line, separated by commas, such as Renfe Cercanías"
    operators: String
    "Whether the consortium has published news about the line"
    hasNews: Boolean
    "Notes about the mode of transport of the line, or null"
    modeNotes: String
    "The town (núcleo) the line was listed for, in the fields that filter by town"
    townId: ID
    "The municipality the line was listed for, in the fields that filter by municipality"
    municipalityId: ID
}

"Stops of a consortium"
type CtanStopList {
    "The stops"
    stops: [CtanStop]
}

"A stop of buses, trains or metro"
type CtanStop {
    "The id of the stop, for the stopId arguments, such as 149"
    id: ID
    "The name of the stop, such as Terminal Muelle Heredia"
    name: String
    "The id of the town (núcleo) of the stop"
    townId: ID
    "The name of the town of the stop"
    town: String
    "The id of the municipality of the stop"
    municipalityId: ID
    "The name of the municipality of the stop"
    municipality: String
    "The fare zone of the stop, such as A for the city of Málaga"
    zoneId: ID
    "The latitude of the stop"
    latitude: Float
    "The longitude of the stop"
    longitude: Float
    "What kind of stop it is, such as Autobús or Metro"
    description: String
    "Notes about the stop that the timetables show"
    notes: String
    "Whether the stop is the main one of a group of stops with the same name, which route searches offer"
    main: Boolean
    "Whether the stop is out of use"
    inactive: Boolean
    "The lines that call at the stop, in Spanish, such as Correspondencia con: M-110,M-113"
    connections: String
}

"The stops of a line, in order"
type CtanLineStopList {
    "The stops, in both directions"
    stops: [CtanLineStop]
}

"A stop of a line, with its place in the order of the line"
type CtanLineStop {
